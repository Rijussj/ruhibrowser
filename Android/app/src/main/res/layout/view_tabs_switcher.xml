<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layoutTabsSwitcher"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/windowBackground"
    android:visibility="gone">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Tabs Switcher Toolbar -->
        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/tabsToolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="?attr/actionBarSize"
            android:background="?attr/colorSurface"
            app:contentInsetStart="8dp"
            app:contentInsetEnd="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/btnDoneTabs"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/action_back"
                    android:src="@drawable/ic_close"
                    app:tint="?attr/colorOnSurface" />

                <TextView
                    android:id="@+id/tvTabsSwitcherTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:text="@string/nav_tabs"
                    android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                    android:textColor="?attr/colorOnSurface"
                    android:textStyle="bold" />

                <ImageButton
                    android:id="@+id/btnNewTabTop"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/menu_new_tab"
                    android:src="@drawable/ic_add"
                    app:tint="?attr/colorOnSurface" />
            </LinearLayout>
        </com.google.android.material.appbar.MaterialToolbar>

        <!-- Tabs Grid -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvTabsGrid"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:padding="8dp" />

    </LinearLayout>

    <!-- Floating Action Button for New Tab -->
    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/fabNewTab"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="32dp"
        android:elevation="6dp"
        app:elevation="6dp"
        android:text="@string/menu_new_tab"
        android:textColor="@color/surface_light"
        app:backgroundTint="@color/brand_primary"
        app:icon="@drawable/ic_add"
        app:iconTint="@color/surface_light" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
