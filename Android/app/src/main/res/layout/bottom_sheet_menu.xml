<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_menu_sheet"
    android:orientation="vertical"
    android:paddingBottom="@dimen/spacing_large">

    <!-- Drag Handle -->
    <com.google.android.material.bottomsheet.BottomSheetDragHandleView
        android:id="@+id/dragHandle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <!-- Sheet Title -->
    <TextView
        android:id="@+id/tvMenuHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/spacing_medium"
        android:paddingEnd="@dimen/spacing_medium"
        android:paddingBottom="@dimen/spacing_small"
        android:text="@string/nav_menu"
        android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
        android:textStyle="bold" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 0. Ruhi Account Profile Card (Firefox Style) -->
            <LinearLayout
                android:id="@+id/itemSync"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_medium"
                android:layout_marginEnd="@dimen/spacing_medium"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_account_card"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingTop="10dp"
                android:paddingEnd="14dp"
                android:paddingBottom="10dp">

                <!-- Avatar Circle with online dot -->
                <FrameLayout
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginEnd="12dp">

                    <View
                        android:id="@+id/viewAccountAvatarBg"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_account_avatar_circle" />

                    <TextView
                        android:id="@+id/tvAccountAvatarInitial"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="👤"
                        android:textColor="@android:color/white"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <!-- Online Green Status Dot -->
                    <View
                        android:id="@+id/viewAccountOnlineDot"
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:layout_gravity="bottom|end"
                        android:background="@drawable/bg_online_dot"
                        android:visibility="gone" />
                </FrameLayout>

                <!-- Text Info -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvAccountTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="Sign in to Ruhi Account"
                        android:textAppearance="@style/TextAppearance.Material3.TitleSmall"
                        android:textColor="?attr/colorOnSurface"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvAccountSubtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="Sync tabs, bookmarks &amp; history"
                        android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                        android:textColor="?attr/colorOnSurfaceVariant" />
                </LinearLayout>

                <!-- Right Chevron -->
                <ImageView
                    android:id="@+id/ivAccountChevron"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginStart="8dp"
                    android:src="@drawable/ic_arrow_forward"
                    app:tint="?attr/colorOnSurfaceVariant" />
            </LinearLayout>

            <View style="@style/RuhiBrowserDividerStyle" />

            <!-- 1. New Tab -->
            <LinearLayout
                android:id="@+id/itemNewTab"
                style="@style/RuhiBrowserMenuItemStyle"
                android:background="?attr/selectableItemBackground">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_add"
                    app:tint="?attr/colorOnSurface" />

                <TextView
                    style="@style/RuhiBrowserMenuTextStyle"
                    android:text="@string/menu_new_tab"
                    android:textColor="?attr/colorOnSurface" />
            </LinearLayout>

            <!-- 2. New Incognito Tab -->
            <LinearLayout
                android:id="@+id/itemNewIncognitoTab"
                style="@style/RuhiBrowserMenuItemStyle"
                android:background="?attr/selectableItemBackground">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_incognito"
                    app:tint="?attr/colorOnSurface" />

                <TextView
                    style="@style/RuhiBrowserMenuTextStyle"
                    android:text="@string/menu_new_incognito_tab"
                    android:textColor="?attr/colorOnSurface" />
            </LinearLayout>

            <View style="@style/RuhiBrowserDividerStyle" />

            <!-- 3. Bookmarks -->
            <LinearLayout
                android:id="@+id/itemBookmarks"
                style="@style/RuhiBrowserMenuItemStyle"
                android:background="?attr/selectableItemBackground">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_bookmarks"
                    app:tint="?attr/colorOnSurface" />

                <TextView
                    style="@style/RuhiBrowserMenuTextStyle"
                    android:text="@string/menu_bookmarks"
                    android:textColor="?attr/colorOnSurface" />
            </LinearLayout>

            <!-- 4. History -->
            <LinearLayout
                android:id="@+id/itemHistory"
                style="@style/RuhiBrowserMenuItemStyle"
                android:background="?attr/selectableItemBackground">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_history"
                    app:tint="?attr/colorOnSurface" />

                <TextView
                    style="@style/RuhiBrowserMenuTextStyle"
                    android:text="@string/menu_history"
                    android:textColor="?attr/colorOnSurface" />
            </LinearLayout>

            <!-- 5. Downloads -->
            <LinearLayout
                android:id="@+id/itemDownloads"
                style="@style/RuhiBrowserMenuItemStyle"
                android:background="?attr/selectableItemBackground">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_download"
                    app:tint="?attr/colorOnSurface" />

                <TextView
                    style="@style/RuhiBrowserMenuTextStyle"
                    android:text="@string/menu_downloads"
                    android:textColor="?attr/colorOnSurface" />
            </LinearLayout>

            <View style="@style/RuhiBrowserDividerStyle" />

            <!-- 6. Desktop Site -->
            <LinearLayout
                android:id="@+id/itemDesktopSite"
                style="@style/RuhiBrowserMenuItemStyle"
                android:background="?attr/selectableItemBackground">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_desktop"
                    app:tint="?attr/colorOnSurface" />

                <TextView
                    style="@style/RuhiBrowserMenuTextStyle"
                    android:text="@string/menu_desktop_site"
                    android:textColor="?attr/colorOnSurface" />

                <ImageView
                    android:id="@+id/ivDesktopSiteCheck"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_check"
                    android:visibility="gone"
                    app:tint="@color/brand_primary" />
            </LinearLayout>

            <!-- 7. Find in Page -->
            <LinearLayout
                android:id="@+id/itemFindInPage"
                style="@style/RuhiBrowserMenuItemStyle"
                android:background="?attr/selectableItemBackground">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_find"
                    app:tint="?attr/colorOnSurface" />

                <TextView
                    style="@style/RuhiBrowserMenuTextStyle"
                    android:text="@string/menu_find_in_page"
                    android:textColor="?attr/colorOnSurface" />
            </LinearLayout>

            <!-- 8. Share -->
            <LinearLayout
                android:id="@+id/itemShare"
                style="@style/RuhiBrowserMenuItemStyle"
                android:background="?attr/selectableItemBackground">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_share"
                    app:tint="?attr/colorOnSurface" />

                <TextView
                    style="@style/RuhiBrowserMenuTextStyle"
                    android:text="Share..."
                    android:textColor="?attr/colorOnSurface" />
            </LinearLayout>

            <!-- 9. Reading Mode -->
            <LinearLayout
                android:id="@+id/itemReaderMode"
                style="@style/RuhiBrowserMenuItemStyle"
                android:background="?attr/selectableItemBackground">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_reader_mode"
                    app:tint="?attr/colorOnSurface" />

                <TextView
                    style="@style/RuhiBrowserMenuTextStyle"
                    android:text="Reading mode"
                    android:textColor="?attr/colorOnSurface" />
            </LinearLayout>

            <!-- 10. Translate Page -->
            <LinearLayout
                android:id="@+id/itemTranslate"
                style="@style/RuhiBrowserMenuItemStyle"
                android:background="?attr/selectableItemBackground">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_translate"
                    app:tint="?attr/colorOnSurface" />

                <TextView
                    style="@style/RuhiBrowserMenuTextStyle"
                    android:text="Translate page..."
                    android:textColor="?attr/colorOnSurface" />
            </LinearLayout>

            <!-- 11. Add to Home Screen (Instant App) -->
            <LinearLayout
                android:id="@+id/itemAddToHomeScreen"
                style="@style/RuhiBrowserMenuItemStyle"
                android:background="?attr/selectableItemBackground">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_add_to_home"
                    app:tint="?attr/colorOnSurface" />

                <TextView
                    style="@style/RuhiBrowserMenuTextStyle"
                    android:text="Add to Home screen"
                    android:textColor="?attr/colorOnSurface" />
            </LinearLayout>

            <!-- 8. AI Assistant -->
            <LinearLayout
                android:id="@+id/itemAiAssistant"
                style="@style/RuhiBrowserMenuItemStyle"
                android:background="?attr/selectableItemBackground">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_ai"
                    app:tint="?attr/colorOnSurface" />

                <TextView
                    style="@style/RuhiBrowserMenuTextStyle"
                    android:text="@string/menu_ai_assistant"
                    android:textColor="?attr/colorOnSurface" />

                <TextView
                    android:id="@+id/tvAiBadge"
                    style="@style/RuhiBrowserBadgeStyle"
                    android:text="Beta" />
            </LinearLayout>

            <!-- 9. VPN -->
            <LinearLayout
                android:id="@+id/itemVpn"
                style="@style/RuhiBrowserMenuItemStyle"
                android:background="?attr/selectableItemBackground">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_vpn"
                    app:tint="?attr/colorOnSurface" />

                <TextView
                    style="@style/RuhiBrowserMenuTextStyle"
                    android:text="@string/menu_vpn"
                    android:textColor="?attr/colorOnSurface" />

                <TextView
                    android:id="@+id/tvVpnBadge"
                    style="@style/RuhiBrowserBadgeStyle"
                    android:text="WireGuard" />
            </LinearLayout>


            <!-- 10. Settings (Active) -->
            <LinearLayout
                android:id="@+id/itemSettings"
                style="@style/RuhiBrowserMenuItemStyle"
                android:background="?attr/selectableItemBackground">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_settings"
                    app:tint="?attr/colorOnSurface" />

                <TextView
                    style="@style/RuhiBrowserMenuTextStyle"
                    android:text="@string/menu_settings"
                    android:textColor="?attr/colorOnSurface" />
            </LinearLayout>

            <!-- 11. Set as Default Browser -->
            <LinearLayout
                android:id="@+id/itemDefaultBrowser"
                style="@style/RuhiBrowserMenuItemStyle"
                android:background="?attr/selectableItemBackground">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_globe"
                    app:tint="?attr/colorOnSurface" />

                <TextView
                    style="@style/RuhiBrowserMenuTextStyle"
                    android:text="Set as default browser"
                    android:textColor="?attr/colorOnSurface" />
            </LinearLayout>

            <View style="@style/RuhiBrowserDividerStyle" />

            <!-- 12. Delete Browsing Data -->
            <LinearLayout
                android:id="@+id/itemClearData"
                style="@style/RuhiBrowserMenuItemStyle"
                android:background="?attr/selectableItemBackground">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_delete"
                    app:tint="@color/brand_accent" />

                <TextView
                    style="@style/RuhiBrowserMenuTextStyle"
                    android:text="Delete browsing data"
                    android:textColor="@color/brand_accent"
                    android:textStyle="bold" />
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>
