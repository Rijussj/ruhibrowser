<Window x:Class="RuhiBrowser.Views.PdfToolsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RUHI PDF Tools &amp; Editor"
        Height="580" Width="640"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBgBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="Segoe UI"
        Icon="/Assets/app_icon.ico"
        ResizeMode="NoResize"
        KeyDown="OnWindowKeyDown">

    <Window.Resources>
        <SolidColorBrush x:Key="WindowBgBrush" Color="#181818"/>
        <SolidColorBrush x:Key="CardBgBrush" Color="#242424"/>
        <SolidColorBrush x:Key="BorderBrushColor" Color="#383838"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#94A3B8"/>
        <SolidColorBrush x:Key="SectionHeadingBrush" Color="#38BDF8"/>
        <SolidColorBrush x:Key="InputBgBrush" Color="#181818"/>
        <SolidColorBrush x:Key="InputBorderBrush" Color="#3C4043"/>
        <SolidColorBrush x:Key="InputTextBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="SecondaryBtnBgBrush" Color="#383838"/>
        <SolidColorBrush x:Key="SecondaryBtnFgBrush" Color="#FFFFFF"/>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="📄" FontSize="24" Margin="0,0,8,0" VerticalAlignment="Center"/>
                <TextBlock Text="RUHI PDF Tools &amp; Editor" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource SectionHeadingBrush}"/>
            </StackPanel>
            <TextBlock Text="Annotate, draw, highlight, rotate, and manage your PDF documents directly" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- File Selection Card -->
        <Border Grid.Row="1" Background="{DynamicResource CardBgBrush}" CornerRadius="8" BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="1" Padding="14" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="TbPdfPath" Background="{DynamicResource InputBgBrush}" Foreground="{DynamicResource InputTextBrush}"
                         BorderBrush="{DynamicResource InputBorderBrush}" Padding="10,7" FontSize="13" VerticalAlignment="Center"
                         IsReadOnly="True" Text="No PDF selected"/>
                <Button Grid.Column="1" Content="Browse PDF..." Background="#2563EB" Foreground="#FFFFFF"
                        FontWeight="SemiBold" Padding="16,8" Margin="8,0,0,0" BorderThickness="0"
                        Click="OnBrowseClicked" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </Grid>
        </Border>

        <!-- Tools Cards Container -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Tool 1: Edit & Annotate -->
                <Border Background="{DynamicResource CardBgBrush}" CornerRadius="8" BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="1" Padding="14" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="✏️ Draw &amp; Annotate in Browser" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="Open in tab with Pen, Highlighter, Add Text, Erase, and Save annotations." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="Open Editor" Background="#2563EB" Foreground="#FFFFFF"
                                FontWeight="SemiBold" Padding="14,6" BorderThickness="0" Click="OnOpenInTabClicked" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </Grid>
                </Border>

                <!-- Tool 2: Rotate Pages -->
                <Border Background="{DynamicResource CardBgBrush}" CornerRadius="8" BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="1" Padding="14" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="🔄 Rotate PDF View" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="Rotate pages clockwise (90° / 180° / 270°) inside the browser tab." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="Rotate 90°" Background="{DynamicResource SecondaryBtnBgBrush}" Foreground="{DynamicResource SecondaryBtnFgBrush}"
                                FontWeight="SemiBold" Padding="14,6" BorderThickness="0" Click="OnRotateClicked" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </Grid>
                </Border>

                <!-- Tool 3: Print / Export -->
                <Border Background="{DynamicResource CardBgBrush}" CornerRadius="8" BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="1" Padding="14" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="🖨️ Print / Save As New PDF" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="Export or print the document with any modifications applied." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="Print / Export" Background="{DynamicResource SecondaryBtnBgBrush}" Foreground="{DynamicResource SecondaryBtnFgBrush}"
                                FontWeight="SemiBold" Padding="14,6" BorderThickness="0" Click="OnPrintClicked" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </Grid>
                </Border>

                <!-- Tool 4: External Editor -->
                <Border Background="{DynamicResource CardBgBrush}" CornerRadius="8" BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="1" Padding="14" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="📂 Open in System Default App" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="Open this PDF in your default Windows PDF editor (e.g. Adobe Acrobat)." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="Open External" Background="{DynamicResource SecondaryBtnBgBrush}" Foreground="{DynamicResource SecondaryBtnFgBrush}"
                                FontWeight="SemiBold" Padding="14,6" BorderThickness="0" Click="OnOpenExternalClicked" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </Grid>
                </Border>

                <!-- How to Edit Guide -->
                <Border Background="{DynamicResource CardBgBrush}" CornerRadius="8" BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="1" Padding="14">
                    <StackPanel>
                        <TextBlock Text="💡 How to Edit &amp; Save PDFs in RUHI Browser:" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource SectionHeadingBrush}" Margin="0,0,0,6"/>
                        <TextBlock Text="1. Click 'Draw' (✏️) on the top toolbar to write, sign, or sketch with pen." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2"/>
                        <TextBlock Text="2. Click 'Text' (🔤) to click anywhere on the page and type text or fill forms." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2"/>
                        <TextBlock Text="3. Use 'Highlight' (🖍️) to highlight important text with customizable colors." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2"/>
                        <TextBlock Text="4. Press Ctrl + S or click the Save icon (💾) to permanently save your edits into the PDF file." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Close" Background="{DynamicResource SecondaryBtnBgBrush}" Foreground="{DynamicResource SecondaryBtnFgBrush}"
                    FontWeight="SemiBold" Padding="20,7" BorderThickness="0" Click="OnCloseClicked" Cursor="Hand">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="6"/>
                    </Style>
                </Button.Resources>
            </Button>
        </StackPanel>
    </Grid>
</Window>
