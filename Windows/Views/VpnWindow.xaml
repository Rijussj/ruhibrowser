<Window x:Class="RuhiBrowser.Views.VpnWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RUHI WireGuard VPN - Privacy Tunnel"
        Height="630" Width="540"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBgBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="Segoe UI"
        Icon="/Assets/app_icon.ico"
        ResizeMode="NoResize"
        KeyDown="OnWindowKeyDown">

    <Window.Resources>
        <SolidColorBrush x:Key="WindowBgBrush" Color="#181818"/>
        <SolidColorBrush x:Key="BorderBrushColor" Color="#383838"/>
        <SolidColorBrush x:Key="CardBgBrush" Color="#242424"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#94A3B8"/>
        <SolidColorBrush x:Key="SectionHeadingBrush" Color="#38BDF8"/>
        <SolidColorBrush x:Key="InputBgBrush" Color="#181818"/>
        <SolidColorBrush x:Key="InputBorderBrush" Color="#3C4043"/>
        <SolidColorBrush x:Key="InputTextBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="SecondaryBtnBgBrush" Color="#383838"/>
        <SolidColorBrush x:Key="SecondaryBtnFgBrush" Color="#FFFFFF"/>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="🛡️" FontSize="22" Margin="0,0,8,0" VerticalAlignment="Center"/>
                <TextBlock Text="RUHI Secure WireGuard VPN" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource SectionHeadingBrush}"/>
            </StackPanel>
            <TextBlock Text="Modern, high-performance privacy tunnel for encrypted browsing" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Status Card -->
        <Border Grid.Row="1" Background="{DynamicResource CardBgBrush}" CornerRadius="10" BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="1" Padding="16" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="TbStatusTitle" Text="VPN Disconnected" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TextBlock x:Name="TbStatusDetail" Text="Configure server parameters below or import a WireGuard profile." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                </StackPanel>
                <Button x:Name="BtnConnect" Grid.Column="1" Content="Connect" Background="#2563EB" Foreground="#FFFFFF"
                        FontWeight="Bold" Padding="20,9" BorderThickness="0" VerticalAlignment="Center"
                        Click="OnConnectToggleClicked" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </Grid>
        </Border>

        <!-- Settings Form -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,10,0">
                <TextBlock Text="SERVER ENDPOINT &amp; KEYS" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SectionHeadingBrush}" Margin="0,0,0,10"/>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="120"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="Server Address / Host:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,4"/>
                        <TextBox x:Name="TbServer" Background="{DynamicResource InputBgBrush}" Foreground="{DynamicResource InputTextBrush}" BorderBrush="{DynamicResource InputBorderBrush}" Padding="8,6" FontSize="13"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Port:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,4"/>
                        <TextBox x:Name="TbPort" Text="51820" Background="{DynamicResource InputBgBrush}" Foreground="{DynamicResource InputTextBrush}" BorderBrush="{DynamicResource InputBorderBrush}" Padding="8,6" FontSize="13"/>
                    </StackPanel>
                </Grid>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,6,0">
                        <TextBlock Text="Client IP Address:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,4"/>
                        <TextBox x:Name="TbClientIp" Text="10.0.0.2/32" Background="{DynamicResource InputBgBrush}" Foreground="{DynamicResource InputTextBrush}" BorderBrush="{DynamicResource InputBorderBrush}" Padding="8,6" FontSize="13"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="6,0,0,0">
                        <TextBlock Text="DNS Server(s):" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,4"/>
                        <TextBox x:Name="TbDns" Text="1.1.1.1, 1.0.0.1" Background="{DynamicResource InputBgBrush}" Foreground="{DynamicResource InputTextBrush}" BorderBrush="{DynamicResource InputBorderBrush}" Padding="8,6" FontSize="13"/>
                    </StackPanel>
                </Grid>

                <StackPanel Margin="0,0,0,10">
                    <TextBlock Text="Server Public Key:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,4"/>
                    <TextBox x:Name="TbPublicKey" Background="{DynamicResource InputBgBrush}" Foreground="{DynamicResource InputTextBrush}" BorderBrush="{DynamicResource InputBorderBrush}" Padding="8,6" FontSize="12" FontFamily="Consolas"/>
                </StackPanel>

                <StackPanel Margin="0,0,0,14">
                    <TextBlock Text="Client Private Key:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,4"/>
                    <PasswordBox x:Name="PbPrivateKey" Background="{DynamicResource InputBgBrush}" Foreground="{DynamicResource InputTextBrush}" BorderBrush="{DynamicResource InputBorderBrush}" Padding="8,6" FontSize="12"/>
                </StackPanel>

                <TextBlock Text="💡 Tip: WireGuard configuration is compatible with standard WireGuard servers and commercial WireGuard-based VPN providers."
                           FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer Buttons -->
        <Grid Grid.Row="3" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Content="Export .conf" Background="{DynamicResource SecondaryBtnBgBrush}" Foreground="{DynamicResource SecondaryBtnFgBrush}" Padding="14,8" BorderThickness="0"
                    Click="OnExportConfClicked" Cursor="Hand">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="6"/>
                    </Style>
                </Button.Resources>
            </Button>

            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button Content="Cancel" Background="Transparent" Foreground="{DynamicResource TextSecondaryBrush}" Padding="16,8" BorderThickness="0"
                        Margin="0,0,8,0" Click="OnCancelClicked" Cursor="Hand"/>
                <Button Content="Save Profile" Background="#2563EB" Foreground="#FFFFFF" FontWeight="Bold" Padding="18,8"
                        BorderThickness="0" Click="OnSaveClicked" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
