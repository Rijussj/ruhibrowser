<Window x:Class="RuhiBrowser.Views.AiAssistantWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI Assistant - RUHI Browser"
        Height="560" Width="520"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBgBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="Segoe UI"
        Icon="/Assets/app_icon.ico"
        KeyDown="OnWindowKeyDown">

    <Window.Resources>
        <SolidColorBrush x:Key="WindowBgBrush" Color="#181818"/>
        <SolidColorBrush x:Key="CardBgBrush" Color="#242424"/>
        <SolidColorBrush x:Key="BorderBrushColor" Color="#383838"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#94A3B8"/>
        <SolidColorBrush x:Key="SectionHeadingBrush" Color="#38BDF8"/>
        <SolidColorBrush x:Key="InputBgBrush" Color="#181818"/>
        <SolidColorBrush x:Key="InputBorderBrush" Color="#3C4043"/>
        <SolidColorBrush x:Key="InputTextBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="SecondaryBtnBgBrush" Color="#383838"/>
        <SolidColorBrush x:Key="SecondaryBtnFgBrush" Color="#FFFFFF"/>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="✨ RUHI AI Assistant" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource SectionHeadingBrush}"/>
                <TextBlock Text="Ask questions or summarize current webpage" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
            </StackPanel>
            <Button Grid.Column="1" Content="Configure API" Background="{DynamicResource SecondaryBtnBgBrush}" Foreground="{DynamicResource SecondaryBtnFgBrush}" Padding="10,4"
                    BorderThickness="0" VerticalAlignment="Center" Click="OnConfigureApiClicked" Cursor="Hand"/>
        </Grid>

        <!-- Current Page Context Checkbox -->
        <Border Grid.Row="1" Background="{DynamicResource CardBgBrush}" CornerRadius="6" Padding="10,8" Margin="0,0,0,10" BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="1">
            <CheckBox x:Name="CbIncludePage" Content="Include current page summary in prompt" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold"/>
        </Border>

        <!-- Response Area -->
        <Border Grid.Row="2" Background="{DynamicResource CardBgBrush}" CornerRadius="8" BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="1" Margin="0,0,0,12" Padding="12">
            <Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="TbResponse" Text="AI assistant is ready. Type your question or request below and click Send."
                               Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13" TextWrapping="Wrap" LineHeight="20"/>
                </ScrollViewer>
                <Button x:Name="BtnCopy" Content="Copy" Background="{DynamicResource SecondaryBtnBgBrush}" Foreground="{DynamicResource SecondaryBtnFgBrush}" Padding="8,4"
                        BorderThickness="0" HorizontalAlignment="Right" VerticalAlignment="Top" Click="OnCopyClicked" Cursor="Hand" Visibility="Collapsed"/>
            </Grid>
        </Border>

        <!-- Prompt Input and Send Button -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox x:Name="TbPrompt" Background="{DynamicResource InputBgBrush}" Foreground="{DynamicResource InputTextBrush}" BorderBrush="{DynamicResource InputBorderBrush}"
                     Padding="10,8" FontSize="13" VerticalAlignment="Center" KeyDown="OnPromptKeyDown"
                     TextWrapping="Wrap" MaxHeight="80"/>

            <Button x:Name="BtnSend" Grid.Column="1" Content="Send" Background="#2563EB" Foreground="#FFFFFF"
                    FontWeight="SemiBold" BorderThickness="0" Padding="18,8" Margin="8,0,0,0" VerticalAlignment="Center"
                    Click="OnSendClicked" Cursor="Hand">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="6"/>
                    </Style>
                </Button.Resources>
            </Button>
        </Grid>
    </Grid>
</Window>
