<Window x:Class="RuhiBrowser.Views.SyncAccountWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ruhi Account" Height="540" Width="480"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource WindowBgBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="Segoe UI">
    <Window.Resources>
        <Style x:Key="ModernBtn" TargetType="Button">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ModernOutlineBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <!-- NOT LOGGED IN PANEL -->
        <StackPanel x:Name="PanelAuth" Visibility="Visible">
            <TextBlock Text="👤 Ruhi Account" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
            <TextBlock Text="Seamlessly sync bookmarks, history, and open tabs across your Windows PC and Android phone." FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,6,0,20" TextWrapping="Wrap"/>

            <!-- Tab Switcher (Login vs Sign Up) -->
            <Border Background="{DynamicResource CardBgBrush}" CornerRadius="8" Padding="3" Margin="0,0,0,18" HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="BtnTabLogin" Content="Sign In" Click="OnTabLoginClicked" Background="#2563EB" Foreground="#FFFFFF" FontWeight="SemiBold" Padding="16,6" BorderThickness="0" Cursor="Hand">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                    </Button>
                    <Button x:Name="BtnTabSignUp" Content="Create Account" Click="OnTabSignUpClicked" Background="Transparent" Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="SemiBold" Padding="16,6" BorderThickness="0" Cursor="Hand">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                    </Button>
                </StackPanel>
            </Border>

            <!-- Name Field (Shown in Create Account mode) -->
            <StackPanel x:Name="PanelNameField" Visibility="Collapsed">
                <TextBlock Text="Your Name" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,6"/>
                <Border Background="{DynamicResource InputBgBrush}" BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="1" CornerRadius="8" Padding="10,6" Margin="0,0,0,14">
                    <TextBox x:Name="TbName" Background="Transparent" Foreground="{DynamicResource TextPrimaryBrush}" BorderThickness="0" FontSize="14"/>
                </Border>
            </StackPanel>

            <!-- Email Field -->
            <TextBlock Text="Email Address" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,6"/>
            <Border Background="{DynamicResource InputBgBrush}" BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="1" CornerRadius="8" Padding="10,6" Margin="0,0,0,14">
                <TextBox x:Name="TbEmail" Background="Transparent" Foreground="{DynamicResource TextPrimaryBrush}" BorderThickness="0" FontSize="14"/>
            </Border>

            <!-- Password Field -->
            <TextBlock Text="Password" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,6"/>
            <Border Background="{DynamicResource InputBgBrush}" BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="1" CornerRadius="8" Padding="10,6" Margin="0,0,0,18">
                <PasswordBox x:Name="PbPassword" Background="Transparent" Foreground="{DynamicResource TextPrimaryBrush}" BorderThickness="0" FontSize="14"/>
            </Border>

            <!-- Status / Error text -->
            <TextBlock x:Name="TbAuthStatus" Text="" Foreground="#EF4444" FontSize="12" Margin="0,0,0,12" TextWrapping="Wrap" Visibility="Collapsed"/>

            <!-- Action Button -->
            <Button x:Name="BtnAuthSubmit" Content="Sign In to Sync" Style="{StaticResource ModernBtn}" Click="OnAuthSubmitClicked" Height="40" Margin="0,0,0,10"/>
        </StackPanel>

        <!-- LOGGED IN PANEL -->
        <ScrollViewer x:Name="PanelDashboard" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="46" Height="46" CornerRadius="23" Background="#2563EB" VerticalAlignment="Center">
                        <TextBlock x:Name="TbLoggedInInitial" Text="👤" FontSize="20" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="TbLoggedInName" Text="User Name" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock x:Name="TbLoggedInEmail" Text="user@ruhibrowser.com" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,1,0,0"/>
                        <TextBlock x:Name="TbSyncStatus" Text="🟢 Connected &amp; Synced" FontSize="11" Foreground="#22C55E" Margin="0,2,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="2" Content="Sign Out" Style="{StaticResource ModernOutlineBtn}" Click="OnLogoutClicked" VerticalAlignment="Center"/>
                </Grid>

                <!-- Profile Name Setting -->
                <Border Background="{DynamicResource CardBgBrush}" CornerRadius="10" Padding="14,12" Margin="0,0,0,16" BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Account Name" FontWeight="SemiBold" FontSize="13"/>
                            <Border Background="{DynamicResource InputBgBrush}" BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="1" CornerRadius="6" Padding="8,4" Margin="0,6,10,0">
                                <TextBox x:Name="TbEditDisplayName" Background="Transparent" Foreground="{DynamicResource TextPrimaryBrush}" BorderThickness="0" FontSize="13"/>
                            </Border>
                        </StackPanel>
                        <Button Grid.Column="1" Content="Save Name" Style="{StaticResource ModernBtn}" Click="OnSaveDisplayNameClicked" VerticalAlignment="Bottom" Padding="12,6"/>
                    </Grid>
                </Border>

                <Border Background="{DynamicResource CardBgBrush}" CornerRadius="10" Padding="14,12" Margin="0,0,0,16" BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Cloud Sync Status" FontWeight="SemiBold" FontSize="13"/>
                            <TextBlock x:Name="TbLastSyncTime" Text="Last synced: Just now" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="⚡ Sync Now" Style="{StaticResource ModernBtn}" Click="OnSyncNowClicked" Padding="12,6"/>
                    </Grid>
                </Border>

                <!-- Linked Devices Section -->
                <TextBlock Text="📱 LINKED DEVICES" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource SectionHeadingBrush}" Margin="2,0,0,8"/>
                <Border Background="{DynamicResource CardBgBrush}" CornerRadius="10" Padding="14,12" Margin="0,0,0,16" BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="1">
                    <StackPanel x:Name="PanelDevicesList">
                        <TextBlock Text="Searching for active devices..." Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/>
                    </StackPanel>
                </Border>

                <!-- Send Active Tab Quick Action -->
                <TextBlock Text="🚀 SEND CURRENT TAB TO DEVICE" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource SectionHeadingBrush}" Margin="2,0,0,8"/>
                <Border Background="{DynamicResource CardBgBrush}" CornerRadius="10" Padding="14,12" BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="TbCurrentTabTitle" Text="Current Tab: Loading..." FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="TbCurrentTabUrl" Text="https://..." FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="📱 Send to Phone" Style="{StaticResource ModernBtn}" Click="OnSendCurrentTabClicked" Padding="12,6" Margin="10,0,0,0"/>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
