<Window x:Class="RuhiBrowser.Views.PasswordsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RUHI Password Vault - Encrypted Credentials"
        Height="620" Width="720"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBgBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="Segoe UI"
        Icon="/Assets/app_icon.ico"
        KeyDown="OnWindowKeyDown">

    <Window.Resources>
        <SolidColorBrush x:Key="WindowBgBrush" Color="#181818"/>
        <SolidColorBrush x:Key="CardBgBrush" Color="#242424"/>
        <SolidColorBrush x:Key="BorderBrushColor" Color="#383838"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#94A3B8"/>
        <SolidColorBrush x:Key="SectionHeadingBrush" Color="#38BDF8"/>
        <SolidColorBrush x:Key="InputBgBrush" Color="#181818"/>
        <SolidColorBrush x:Key="InputBorderBrush" Color="#3C4043"/>
        <SolidColorBrush x:Key="InputTextBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="SecondaryBtnBgBrush" Color="#383838"/>
        <SolidColorBrush x:Key="SecondaryBtnFgBrush" Color="#FFFFFF"/>

        <Style TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBorder" Background="{TemplateBinding Background}"
                                BorderBrush="Transparent" BorderThickness="1" CornerRadius="6"
                                Padding="{TemplateBinding Padding}" Margin="2,2">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#383838"/>
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#3C4043"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#1E3A8A"/>
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#2563EB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🔐" FontSize="22" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="RUHI Password Vault" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource SectionHeadingBrush}"/>
                </StackPanel>
                <TextBlock Text="Military-grade encrypted password storage powered by Windows DPAPI" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3,0,0"/>
            </StackPanel>

            <Button x:Name="BtnAddNew" Grid.Column="1" Content="+ Add Password" Background="#2563EB" Foreground="#FFFFFF"
                    FontWeight="SemiBold" Padding="16,8" BorderThickness="0" Click="OnAddNewClicked" Cursor="Hand">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="6"/>
                    </Style>
                </Button.Resources>
            </Button>
        </Grid>

        <!-- Add Credential Inline Card (Initially Collapsed) -->
        <Border x:Name="BorderAddCard" Grid.Row="1" Background="{DynamicResource CardBgBrush}" CornerRadius="8"
                BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="1" Padding="14" Margin="0,0,0,16" Visibility="Collapsed">
            <StackPanel>
                <TextBlock Text="Add New Credential" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,10"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,6,0">
                        <TextBlock Text="Website URL / Domain" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,3"/>
                        <TextBox x:Name="TbNewWebsite" Background="{DynamicResource InputBgBrush}" Foreground="{DynamicResource InputTextBrush}"
                                 BorderBrush="{DynamicResource InputBorderBrush}" Padding="8,6" FontSize="12"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="6,0,6,0">
                        <TextBlock Text="Username / Email" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,3"/>
                        <TextBox x:Name="TbNewUsername" Background="{DynamicResource InputBgBrush}" Foreground="{DynamicResource InputTextBrush}"
                                 BorderBrush="{DynamicResource InputBorderBrush}" Padding="8,6" FontSize="12"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="6,0,0,0">
                        <TextBlock Text="Password" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,3"/>
                        <PasswordBox x:Name="PbNewPassword" Background="{DynamicResource InputBgBrush}" Foreground="{DynamicResource InputTextBrush}"
                                     BorderBrush="{DynamicResource InputBorderBrush}" Padding="8,6" FontSize="12"/>
                    </StackPanel>
                </Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                    <Button Content="Cancel" Background="Transparent" Foreground="{DynamicResource TextSecondaryBrush}" BorderThickness="0"
                            Padding="12,5" Margin="0,0,8,0" Click="OnCancelAddClicked" Cursor="Hand"/>
                    <Button Content="Save to Vault" Background="#16A34A" Foreground="#FFFFFF" FontWeight="Bold" BorderThickness="0"
                            Padding="16,5" Click="OnSaveNewCredentialClicked" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Search Bar -->
        <Border Grid.Row="2" Background="{DynamicResource CardBgBrush}" CornerRadius="8" BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="1" Padding="10,6" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="🔍" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="4,0,8,0"/>
                <TextBox x:Name="TbSearch" Grid.Column="1" Background="Transparent" Foreground="{DynamicResource InputTextBrush}"
                         BorderThickness="0" FontSize="13" VerticalAlignment="Center" TextChanged="OnSearchTextChanged"/>
                <TextBlock x:Name="TbCount" Grid.Column="2" Text="0 passwords" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="8,0,4,0"/>
            </Grid>
        </Border>

        <!-- Passwords List -->
        <ListBox x:Name="LbCredentials" Grid.Row="3" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrushColor}"
                 BorderThickness="1" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="0,0,0,1" Padding="12,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Website -->
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding WebsiteTitle}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding WebsiteUrl}" FontSize="11" Foreground="#38BDF8" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                            </StackPanel>

                            <!-- Username -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0">
                                <TextBlock Text="{Binding Username}" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="140"/>
                                <Button Content="📋" ToolTip="Copy Username" Background="Transparent" BorderThickness="0" FontSize="11"
                                        Margin="4,0,0,0" Padding="4,2" Click="OnCopyUsernameClicked" Tag="{Binding Username}" Cursor="Hand"/>
                            </StackPanel>

                            <!-- Password -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0">
                                <TextBlock Text="{Binding DisplayPassword}" FontFamily="Consolas" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                <Button Content="{Binding RevealIcon}" ToolTip="Show/Hide Password" Background="Transparent" BorderThickness="0" FontSize="11"
                                        Margin="6,0,2,0" Padding="4,2" Click="OnToggleRevealClicked" Tag="{Binding}" Cursor="Hand"/>
                                <Button Content="📋" ToolTip="Copy Password" Background="Transparent" BorderThickness="0" FontSize="11"
                                        Padding="4,2" Click="OnCopyPasswordClicked" Tag="{Binding}" Cursor="Hand"/>
                            </StackPanel>

                            <!-- Delete Button -->
                            <Button Grid.Column="3" Content="🗑️" ToolTip="Delete Credential" Background="Transparent" Foreground="#EF4444"
                                    BorderThickness="0" Padding="8,4" VerticalAlignment="Center" Click="OnDeleteClicked" Tag="{Binding Id}" Cursor="Hand"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Footer -->
        <Grid Grid.Row="4" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="🛡 All credentials encrypted with Windows Data Protection API (DPAPI). Never shared or sent to any server."
                       FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>

            <Button Grid.Column="1" Content="Close" Background="{DynamicResource SecondaryBtnBgBrush}" Foreground="{DynamicResource SecondaryBtnFgBrush}"
                    FontWeight="SemiBold" Padding="20,6" BorderThickness="0" Click="OnCloseClicked" Cursor="Hand">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="6"/>
                    </Style>
                </Button.Resources>
            </Button>
        </Grid>
    </Grid>
</Window>
