<Window x:Class="RuhiBrowser.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings - RUHI Browser"
        Width="1100" Height="800"
        MinWidth="800" MinHeight="600"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBgBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="Segoe UI"
        KeyDown="OnWindowKeyDown"
        Icon="/Assets/app_icon.ico">

    <Window.Resources>
        <SolidColorBrush x:Key="WindowBgBrush" Color="#181818"/>
        <SolidColorBrush x:Key="HeaderFooterBgBrush" Color="#28292C"/>
        <SolidColorBrush x:Key="BorderBrushColor" Color="#383838"/>
        <SolidColorBrush x:Key="CardBgBrush" Color="#242424"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#94A3B8"/>
        <SolidColorBrush x:Key="SectionHeadingBrush" Color="#38BDF8"/>
        <SolidColorBrush x:Key="InputBgBrush" Color="#181818"/>
        <SolidColorBrush x:Key="InputBorderBrush" Color="#3C4043"/>
        <SolidColorBrush x:Key="InputTextBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="SecondaryBtnBgBrush" Color="#383838"/>
        <SolidColorBrush x:Key="SecondaryBtnFgBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="CloseBtnBgBrush" Color="#383838"/>
        <SolidColorBrush x:Key="CloseBtnFgBrush" Color="#94A3B8"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- 0: Header -->
            <RowDefinition Height="Auto"/>
            <!-- 1: Scrollable Settings Content -->
            <RowDefinition Height="*"/>
            <!-- 2: Sticky Bottom Action Bar -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top Header Bar -->
        <Border Grid.Row="0" Background="{DynamicResource HeaderFooterBgBrush}" BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="0,0,0,1" Padding="32,16">
            <Grid MaxWidth="960" HorizontalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{DynamicResource SecondaryBtnBgBrush}" CornerRadius="8" Width="42" Height="42" Margin="0,0,16,0" BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1">
                        <TextBlock Text="⚙" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource SectionHeadingBrush}"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Settings" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="Customize browser preferences, appearance, search engines, AI, and VPN" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <Button Grid.Column="1" Content="✕ Close" Background="{DynamicResource CloseBtnBgBrush}" Foreground="{DynamicResource CloseBtnFgBrush}" BorderThickness="0"
                        Padding="14,8" FontSize="12" Cursor="Hand" Click="OnCancelClicked" VerticalAlignment="Center">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </Grid>
        </Border>

        <!-- Scrollable Settings Sections -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,24,24,24">
            <StackPanel MaxWidth="960" HorizontalAlignment="Center">

                <!-- 1. GENERAL / DEFAULT BROWSER & HOMEPAGE -->
                <TextBlock Text="GENERAL PREFERENCES" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource SectionHeadingBrush}" Margin="4,0,0,10"/>
                
                <Border Background="{DynamicResource CardBgBrush}" CornerRadius="10" Padding="18,16" Margin="0,0,0,12" BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Default Browser" FontWeight="SemiBold" FontSize="15" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock x:Name="TbDefaultBrowserStatus" Text="Detecting default browser status..." FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="Set as Default" Background="#2563EB" Foreground="#FFFFFF" FontWeight="SemiBold"
                                Padding="16,8" BorderThickness="0" Click="OnSetDefaultBrowserClicked" Cursor="Hand" VerticalAlignment="Center">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </Grid>
                </Border>

                <!-- Homepage / New Tab Option -->
                <Border Background="{DynamicResource CardBgBrush}" CornerRadius="10" Padding="18,16" Margin="0,0,0,24" BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="1">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="240"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="On Startup / New Tab" FontWeight="SemiBold" FontSize="15" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Text="Choose what webpage or dashboard opens when a new tab is created" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                            </StackPanel>
                            <ComboBox x:Name="CbHomepageMode" Grid.Column="1" VerticalAlignment="Center" Background="#FFFFFF" Foreground="#000000" Padding="10,6" FontSize="13"
                                      SelectionChanged="OnHomepageModeChanged">
                                <ComboBox.Resources>
                                    <Style TargetType="ComboBoxItem">
                                        <Setter Property="Foreground" Value="#000000"/>
                                        <Setter Property="Background" Value="#FFFFFF"/>
                                        <Setter Property="Padding" Value="10,6"/>
                                    </Style>
                                </ComboBox.Resources>
                                <ComboBoxItem Content="RUHI Home Screen" Foreground="#000000"/>
                                <ComboBoxItem x:Name="CbiExtensionMode" Content="Extension New Tab Page" Foreground="#000000"/>
                                <ComboBoxItem Content="Google" Foreground="#000000"/>
                                <ComboBoxItem Content="Blank Page" Foreground="#000000"/>
                                <ComboBoxItem Content="Custom URL" Foreground="#000000"/>
                            </ComboBox>
                        </Grid>

                        <!-- Home Screen Layout Preset Selector -->
                        <Grid x:Name="GridHomeScreenStyle" Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="260"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Home Screen Layout" FontWeight="Medium" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock x:Name="TbHomeScreenStyleDesc" Text="Choose home screen preset (Simple, News, Productive, etc.)" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <ComboBox x:Name="CbHomeScreenStyle" Grid.Column="1" VerticalAlignment="Center" Background="#FFFFFF" Foreground="#000000" Padding="10,6" FontSize="13"
                                      SelectionChanged="OnHomeScreenStyleChanged">
                                <ComboBox.Resources>
                                    <Style TargetType="ComboBoxItem">
                                        <Setter Property="Foreground" Value="#000000"/>
                                        <Setter Property="Background" Value="#FFFFFF"/>
                                        <Setter Property="Padding" Value="10,6"/>
                                    </Style>
                                </ComboBox.Resources>
                                <ComboBoxItem Content="⚡ Simple (Search &amp; Shortcuts)" Tag="Simple" Foreground="#000000"/>
                                <ComboBoxItem Content="📰 With News (Trending Feed)" Tag="News" Foreground="#000000"/>
                                <ComboBoxItem Content="🧭 Standard (Shortcuts &amp; History)" Tag="Standard" Foreground="#000000"/>
                                <ComboBoxItem Content="⏱ Productive (Clock &amp; Notes)" Tag="Productive" Foreground="#000000"/>
                                <ComboBoxItem Content="🌄 Scenic Wallpaper (Aesthetic)" Tag="Wallpaper" Foreground="#000000"/>
                            </ComboBox>
                        </Grid>

                        <TextBox x:Name="TbCustomHomepageUrl" Visibility="Collapsed" Margin="0,12,0,0" Background="{DynamicResource InputBgBrush}" Foreground="{DynamicResource InputTextBrush}"
                                 BorderBrush="{DynamicResource InputBorderBrush}" Padding="10,8" FontSize="13" Text="https://"/>
                    </StackPanel>
                </Border>

                <!-- 2. SEARCH ENGINE -->
                <TextBlock Text="SEARCH ENGINE" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource SectionHeadingBrush}" Margin="4,0,0,10"/>
                <Border Background="{DynamicResource CardBgBrush}" CornerRadius="10" Padding="18,16" Margin="0,0,0,24" BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="240"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Default Search Engine" FontWeight="SemiBold" FontSize="15" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="Engine used for address bar search and instant queries" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <ComboBox x:Name="CbSearchEngine" Grid.Column="1" VerticalAlignment="Center" Background="#FFFFFF" Foreground="#000000" Padding="10,6" FontSize="13">
                            <ComboBox.Resources>
                                <Style TargetType="ComboBoxItem">
                                    <Setter Property="Foreground" Value="#000000"/>
                                    <Setter Property="Background" Value="#FFFFFF"/>
                                    <Setter Property="Padding" Value="10,6"/>
                                </Style>
                            </ComboBox.Resources>
                            <ComboBoxItem Content="Google" Foreground="#000000"/>
                            <ComboBoxItem Content="Bing" Foreground="#000000"/>
                            <ComboBoxItem Content="DuckDuckGo" Foreground="#000000"/>
                            <ComboBoxItem Content="Ecosia" Foreground="#000000"/>
                            <ComboBoxItem Content="Yahoo" Foreground="#000000"/>
                            <ComboBoxItem Content="Brave" Foreground="#000000"/>
                        </ComboBox>
                    </Grid>
                </Border>

                <!-- 3. APPEARANCE & THEME -->
                <TextBlock Text="APPEARANCE &amp; THEME" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource SectionHeadingBrush}" Margin="4,0,0,10"/>
                <Border Background="{DynamicResource CardBgBrush}" CornerRadius="10" Padding="18,16" Margin="0,0,0,24" BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="240"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Theme Mode" FontWeight="SemiBold" FontSize="15" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="Choose browser interface theme (Dark, Light, or follow Windows system default)" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <ComboBox x:Name="CbTheme" Grid.Column="1" VerticalAlignment="Center" Background="#FFFFFF" Foreground="#000000" Padding="10,6" FontSize="13"
                                  SelectionChanged="OnThemeSelectionChanged">
                            <ComboBox.Resources>
                                <Style TargetType="ComboBoxItem">
                                    <Setter Property="Foreground" Value="#000000"/>
                                    <Setter Property="Background" Value="#FFFFFF"/>
                                    <Setter Property="Padding" Value="10,6"/>
                                </Style>
                            </ComboBox.Resources>
                            <ComboBoxItem Content="Dark" Foreground="#000000"/>
                            <ComboBoxItem Content="Light" Foreground="#000000"/>
                            <ComboBoxItem Content="System" Foreground="#000000"/>
                        </ComboBox>
                    </Grid>
                </Border>

                <!-- 4. PRIVACY & SECURITY -->
                <TextBlock Text="PRIVACY &amp; SECURITY" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource SectionHeadingBrush}" Margin="4,0,0,10"/>
                <Border Background="{DynamicResource CardBgBrush}" CornerRadius="10" Padding="18,16" Margin="0,0,0,12" BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Ad &amp; Tracker Blocker" FontWeight="SemiBold" FontSize="15" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="Block invasive advertising, tracking scripts, and telemetry requests across all tabs" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <CheckBox x:Name="CbAdBlock" Grid.Column="1" VerticalAlignment="Center" Content="Enabled"
                                  Foreground="#60A5FA" FontWeight="SemiBold" FontSize="14" Checked="OnAdBlockChecked" Unchecked="OnAdBlockUnchecked"/>
                    </Grid>
                </Border>

                <Border Background="{DynamicResource CardBgBrush}" CornerRadius="10" Padding="18,16" Margin="0,0,0,12" BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Password Manager &amp; Encrypted Vault" FontWeight="SemiBold" FontSize="15" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="Manage, view, and organize your saved website login credentials with Windows DPAPI encryption" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="Manage Passwords..." Background="{DynamicResource SecondaryBtnBgBrush}" Foreground="{DynamicResource SecondaryBtnFgBrush}"
                                FontWeight="SemiBold" Padding="16,8" BorderThickness="0" Click="OnManagePasswordsClicked" Cursor="Hand" VerticalAlignment="Center">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </Grid>
                </Border>

                <Border Background="{DynamicResource CardBgBrush}" CornerRadius="10" Padding="18,16" Margin="0,0,0,12" BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Chrome Extensions &amp; Add-ons 🧩" FontWeight="SemiBold" FontSize="15" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="Install and manage extensions (.crx / .zip / unpacked) including uBlock Origin, Dark Reader, and Web Store add-ons" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="Manage Extensions..." Background="{DynamicResource SecondaryBtnBgBrush}" Foreground="{DynamicResource SecondaryBtnFgBrush}"
                                FontWeight="SemiBold" Padding="16,8" BorderThickness="0" Click="OnManageExtensionsClicked" Cursor="Hand" VerticalAlignment="Center">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </Grid>
                </Border>

                <Border Background="{DynamicResource CardBgBrush}" CornerRadius="10" Padding="18,16" Margin="0,0,0,24" BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Clear Browsing Data" FontWeight="SemiBold" FontSize="15" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="Delete history, cookies, cache, web storage, and bookmarks" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="Clear Data..." Background="#7F1D1D" Foreground="#FECACA" FontWeight="SemiBold" Padding="16,8"
                                BorderThickness="0" Click="OnClearDataClicked" Cursor="Hand" VerticalAlignment="Center">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </Grid>
                </Border>

                <!-- 5. PERFORMANCE & MEMORY SAVER -->
                <TextBlock Text="PERFORMANCE &amp; MEMORY SAVER" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource SectionHeadingBrush}" Margin="4,0,0,10"/>
                <Border Background="{DynamicResource CardBgBrush}" CornerRadius="10" Padding="18,16" Margin="0,0,0,24" BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Memory Saver / Tab Snoozing (RAM 50% बचत) ⚡" FontWeight="SemiBold" FontSize="15" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="Deactivates inactive background tabs after 20 minutes to save system RAM and battery" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <CheckBox x:Name="CbMemorySaver" Grid.Column="1" VerticalAlignment="Center" Content="Enabled"
                                  Foreground="#60A5FA" FontWeight="SemiBold" FontSize="14"/>
                    </Grid>
                </Border>

                <!-- 6. DOWNLOADS -->
                <TextBlock Text="DOWNLOADS" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource SectionHeadingBrush}" Margin="4,0,0,10"/>
                <Border Background="{DynamicResource CardBgBrush}" CornerRadius="10" Padding="18,16" Margin="0,0,0,24" BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Downloads Folder" FontWeight="SemiBold" FontSize="15" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="Location where downloaded files are saved automatically" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="Browse Folder..." Background="{DynamicResource SecondaryBtnBgBrush}" Foreground="{DynamicResource SecondaryBtnFgBrush}" FontWeight="SemiBold" Padding="16,8"
                                BorderThickness="0" Click="OnBrowseDownloadsClicked" Cursor="Hand" VerticalAlignment="Center">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                        <TextBlock x:Name="TbDownloadsPath" Grid.Row="1" Grid.ColumnSpan="2" Text="C:\Users\...\Downloads"
                                   FontSize="13" Foreground="#60A5FA" Margin="0,10,0,0" TextTrimming="CharacterEllipsis"/>
                    </Grid>
                </Border>

                <!-- 6. RUHI AI ASSISTANT -->
                <TextBlock Text="AI ASSISTANT (Hugging Face)" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource SectionHeadingBrush}" Margin="4,0,0,10"/>
                <Border Background="{DynamicResource CardBgBrush}" CornerRadius="10" Padding="18,16" Margin="0,0,0,24" BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="1">
                    <StackPanel>
                        <Grid Margin="0,0,0,6">
                            <TextBlock Text="Hugging Face API Token:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13"/>
                            <Button x:Name="BtnToggleToken" Content="Show" HorizontalAlignment="Right" Background="Transparent"
                                    Foreground="{DynamicResource SectionHeadingBrush}" BorderThickness="0" Cursor="Hand" Click="OnToggleTokenVisibility"/>
                        </Grid>
                        <Grid Margin="0,0,0,14">
                            <PasswordBox x:Name="PbAiToken" Background="{DynamicResource InputBgBrush}" Foreground="{DynamicResource InputTextBrush}" BorderBrush="{DynamicResource InputBorderBrush}" Padding="10,8" FontSize="13"/>
                            <TextBox x:Name="TbAiTokenVisible" Visibility="Collapsed" Background="{DynamicResource InputBgBrush}" Foreground="{DynamicResource InputTextBrush}" BorderBrush="{DynamicResource InputBorderBrush}" Padding="10,8" FontSize="13"/>
                        </Grid>

                        <Grid Margin="0,0,0,6">
                            <TextBlock Text="Model Inference Endpoint:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13"/>
                            <Button Content="Reset Default" HorizontalAlignment="Right" Background="Transparent"
                                    Foreground="{DynamicResource SectionHeadingBrush}" BorderThickness="0" Cursor="Hand" Click="OnResetAiEndpoint"/>
                        </Grid>
                        <TextBox x:Name="TbAiEndpoint" Background="{DynamicResource InputBgBrush}" Foreground="{DynamicResource InputTextBrush}" BorderBrush="{DynamicResource InputBorderBrush}" Padding="10,8" FontSize="13" Margin="0,0,0,12"/>

                        <!-- Test AI Button & Result -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="BtnTestAi" Content="Test Connection" Background="{DynamicResource SecondaryBtnBgBrush}" Foreground="{DynamicResource SecondaryBtnFgBrush}" FontWeight="SemiBold"
                                    Padding="14,6" BorderThickness="0" Cursor="Hand" Click="OnTestAiClicked">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="6"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                            <TextBlock x:Name="TbAiTestResult" Grid.Column="1" Text="" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                                       VerticalAlignment="Center" Margin="14,0,0,0" TextTrimming="CharacterEllipsis"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 7. WIREGUARD VPN -->
                <TextBlock Text="WIREGUARD VPN" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource SectionHeadingBrush}" Margin="4,0,0,10"/>
                <Border Background="{DynamicResource CardBgBrush}" CornerRadius="10" Padding="18,16" Margin="0,0,0,24" BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="WireGuard Tunnel Profile" FontWeight="SemiBold" FontSize="15" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock x:Name="TbVpnStatusSummary" Text="Configure server address, port, and cryptographic keys" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="Configure VPN..." Background="#2563EB" Foreground="#FFFFFF" FontWeight="SemiBold" Padding="16,8"
                                BorderThickness="0" Click="OnOpenVpnSettingsClicked" Cursor="Hand" VerticalAlignment="Center">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </Grid>
                </Border>

                <!-- 8. RESET SETTINGS -->
                <TextBlock Text="RESET SETTINGS" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource SectionHeadingBrush}" Margin="4,0,0,10"/>
                <Border Background="{DynamicResource CardBgBrush}" CornerRadius="10" Padding="18,16" Margin="0,0,0,24" BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="Restore settings to their original defaults" FontWeight="SemiBold" FontSize="15" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="Resets startup page, new tab layout, search engine, theme, AdBlock, and download preferences. Your bookmarks, browsing history, and saved passwords will not be deleted."
                                       FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="Reset Settings" Background="#DC2626" Foreground="#FFFFFF" FontWeight="SemiBold" Padding="16,8"
                                BorderThickness="0" Click="OnResetSettingsClicked" Cursor="Hand" VerticalAlignment="Center">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </Grid>
                </Border>

                <!-- 9. ABOUT & LEGAL -->
                <TextBlock Text="ABOUT &amp; LEGAL" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource SectionHeadingBrush}" Margin="4,0,0,10"/>
                <Border Background="{DynamicResource CardBgBrush}" CornerRadius="10" Padding="18,16" Margin="0,0,0,32" BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="RUHI Browser v1.0.0" FontWeight="SemiBold" FontSize="15" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="RUHI Application | Developer: Saikh Sufian" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,2"/>
                            <TextBlock Text="Contact: myjawla@gmail.com" FontSize="12" Foreground="#60A5FA"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="About &amp; Licenses" Background="#2563EB" Foreground="#FFFFFF" FontWeight="SemiBold" Padding="16,8"
                                BorderThickness="0" Click="OnOpenAboutClicked" Cursor="Hand" VerticalAlignment="Center">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Sticky Bottom Action Bar -->
        <Border Grid.Row="2" Background="{DynamicResource HeaderFooterBgBrush}" BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="0,1,0,0" Padding="32,14">
            <Grid MaxWidth="960" HorizontalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Changes apply immediately upon saving" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Cancel" Background="Transparent" Foreground="{DynamicResource TextSecondaryBrush}" BorderThickness="0" Padding="18,9" Margin="0,0,12,0" Click="OnCancelClicked" Cursor="Hand" FontSize="13"/>
                    <Button Content="Save Settings" Background="#2563EB" Foreground="#FFFFFF" FontWeight="Bold" FontSize="13" BorderThickness="0" Padding="26,9" Click="OnSaveClicked" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
