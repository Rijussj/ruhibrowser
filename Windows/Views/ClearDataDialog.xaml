<Window x:Class="RuhiBrowser.Views.ClearDataDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Clear Browsing Data"
        Height="360" Width="440"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBgBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="Segoe UI"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Icon="/Assets/app_icon.ico"
        KeyDown="OnWindowKeyDown">

    <Window.Resources>
        <SolidColorBrush x:Key="WindowBgBrush" Color="#181818"/>
        <SolidColorBrush x:Key="CardBgBrush" Color="#242424"/>
        <SolidColorBrush x:Key="BorderBrushColor" Color="#383838"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#94A3B8"/>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Clear Browsing Data" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
            <TextBlock Text="Select the data you wish to delete from RUHI Browser" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Checkboxes -->
        <Border Grid.Row="1" Background="{DynamicResource CardBgBrush}" CornerRadius="8" Padding="14" BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="1">
            <StackPanel VerticalAlignment="Center">
                <CheckBox x:Name="CbHistory" Content="Browsing history" IsChecked="True" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13" Margin="0,0,0,12"/>
                <CheckBox x:Name="CbCookies" Content="Cookies and site data" IsChecked="True" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13" Margin="0,0,0,12"/>
                <CheckBox x:Name="CbCache" Content="Cached images and files" IsChecked="True" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13" Margin="0,0,0,12"/>
                <CheckBox x:Name="CbBookmarks" Content="Saved bookmarks" IsChecked="False" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13" Margin="0,0,0,12"/>
                <CheckBox x:Name="CbPasswords" Content="Saved passwords (Password Vault)" IsChecked="False" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13"/>
            </StackPanel>
        </Border>

        <!-- Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" Background="Transparent" Foreground="{DynamicResource TextSecondaryBrush}" BorderThickness="0" Padding="14,6" Margin="0,0,8,0" Click="OnCancelClicked" Cursor="Hand"/>
            <Button Content="Clear Data" Background="#DC2626" Foreground="#FFFFFF" FontWeight="Bold" BorderThickness="0" Padding="18,6" Click="OnClearClicked" Cursor="Hand">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="6"/>
                    </Style>
                </Button.Resources>
            </Button>
        </StackPanel>
    </Grid>
</Window>
