<Window x:Class="RuhiBrowser.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About RUHI Browser"
        Height="560" Width="640"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBgBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="Segoe UI"
        Icon="/Assets/app_icon.ico"
        ResizeMode="NoResize"
        KeyDown="OnWindowKeyDown">

    <Window.Resources>
        <SolidColorBrush x:Key="WindowBgBrush" Color="#181818"/>
        <SolidColorBrush x:Key="HeaderFooterBgBrush" Color="#28292C"/>
        <SolidColorBrush x:Key="BorderBrushColor" Color="#383838"/>
        <SolidColorBrush x:Key="CardBgBrush" Color="#242424"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#94A3B8"/>
        <SolidColorBrush x:Key="SectionHeadingBrush" Color="#38BDF8"/>
        <SolidColorBrush x:Key="SecondaryBtnBgBrush" Color="#383838"/>
        <SolidColorBrush x:Key="SecondaryBtnFgBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="InputBorderBrush" Color="#3C4043"/>
    </Window.Resources>

    <Grid Margin="20,16,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0" Background="Transparent" BorderBrush="{DynamicResource BorderBrushColor}">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="Background" Value="{DynamicResource SecondaryBtnBgBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushColor}"/>
                    <Setter Property="BorderThickness" Value="1,1,1,0"/>
                    <Setter Property="Padding" Value="18,8"/>
                    <Setter Property="FontSize" Value="13"/>
                    <Setter Property="Cursor" Value="Hand"/>
                    <Setter Property="Margin" Value="0,0,4,0"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabItem">
                                <Border x:Name="TabBorder"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="8,8,0,0"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter x:Name="TabContent"
                                                      ContentSource="Header"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      RecognizesAccessKey="True"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="TabBorder" Property="Background" Value="#1E2E4A"/>
                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                        <Setter TargetName="TabBorder" Property="BorderBrush" Value="#3B82F6"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="TabBorder" Property="Background" Value="#2563EB"/>
                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                        <Setter TargetName="TabBorder" Property="BorderBrush" Value="#60A5FA"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TabControl.Resources>

            <!-- Tab 1: About RUHI Browser -->
            <TabItem Header="About">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,16,0,0">
                    <StackPanel HorizontalAlignment="Center" Width="520">
                        <Image Source="/Assets/app_icon.png" Width="72" Height="72" Margin="0,10,0,10" HorizontalAlignment="Center"/>
                        
                        <TextBlock Text="RUHI Browser" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Text="Version 1.0.0 (Official Release)" FontSize="13" Foreground="#2563EB" Margin="0,4,0,12" HorizontalAlignment="Center"/>
                        
                        <TextBlock Text="A high-performance, privacy-first web browser designed for pure simplicity, zero telemetry, and maximum security on Windows."
                                   TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" TextAlignment="Center" Margin="0,0,0,16"/>

                        <Border Background="{DynamicResource CardBgBrush}" CornerRadius="8" Padding="16" Margin="0,0,0,16" BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="• Engine: Microsoft Edge WebView2 (Chromium)" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13" Margin="0,3"/>
                                <TextBlock Text="• Architecture: Native Windows C# / .NET 6 (WPF)" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13" Margin="0,3"/>
                                <TextBlock Text="• Privacy: 100% Local Device Storage • Zero Telemetry" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13" Margin="0,3"/>
                                <TextBlock Text="• Developer: RUHI Application" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13" Margin="0,3"/>
                                <TextBlock Text="• Developer Name: Saikh Sufian" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13" Margin="0,3"/>
                                <TextBlock Text="• Official Email: myjawla@gmail.com" Foreground="#38BDF8" FontSize="13" Margin="0,3" Cursor="Hand" MouseDown="OnEmailClicked"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="© 2026 RUHI Application. All rights reserved." Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Tab 2: Privacy Policy -->
            <TabItem Header="Privacy Policy">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,16,0,0">
                    <StackPanel Margin="10,0,10,10">
                        <TextBlock Text="RUHI Browser Privacy Policy" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource SectionHeadingBrush}" Margin="0,0,0,4"/>
                        <TextBlock Text="Effective Date: October 2026 | Developer: RUHI Application" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,12"/>

                        <TextBlock Text="1. Zero Remote Tracking &amp; No Data Collection" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13" Margin="0,8,0,2"/>
                        <TextBlock Text="RUHI Browser does NOT collect, store, sell, or transmit any Personally Identifiable Information (PII), browsing history, search terms, IP addresses, or device identifiers to any remote servers." TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/>

                        <TextBlock Text="2. 100% On-Device Local Storage" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13" Margin="0,10,0,2"/>
                        <TextBlock Text="All user data—including Bookmarks, Browsing History, Shortcuts, and Settings—is stored exclusively on your local device in encrypted app-private storage. None of this data is sent or synchronized to any external cloud." TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/>

                        <TextBlock Text="3. InPrivate / Incognito Mode" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13" Margin="0,10,0,2"/>
                        <TextBlock Text="When browsing in InPrivate mode, browsing history is disabled entirely. Session cookies and temporary cache are completely wiped from memory upon closing the session." TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/>

                        <TextBlock Text="4. User Data Control &amp; Deletion" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13" Margin="0,10,0,2"/>
                        <TextBlock Text="You retain 100% control over all data stored on your computer. You can erase all browsing history, cache, cookies, and bookmarks at any moment via the menu." TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/>

                        <TextBlock Text="5. Official Contact" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13" Margin="0,10,0,2"/>
                        <TextBlock Text="Questions or inquiries? Contact Developer Saikh Sufian directly at myjawla@gmail.com." TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,10"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Tab 3: Open Source Licenses -->
            <TabItem Header="Open Source Licenses">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,16,0,0">
                    <StackPanel Margin="10,0,10,10">
                        <TextBlock Text="Open Source Software Notices" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource SectionHeadingBrush}" Margin="0,0,0,4"/>
                        <TextBlock Text="Click any project to open its official repository in the browser." FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,14"/>

                        <Border Background="{DynamicResource CardBgBrush}" CornerRadius="8" Padding="14" Margin="0,0,0,10" BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="1" Cursor="Hand" MouseDown="OnLicenseChromiumClicked">
                            <StackPanel>
                                <TextBlock Text="Chromium / Microsoft Edge WebView2" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13"/>
                                <TextBlock Text="BSD-3-Clause License • chromium.googlesource.com ↗" Foreground="#38BDF8" FontSize="11" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Background="{DynamicResource CardBgBrush}" CornerRadius="8" Padding="14" Margin="0,0,0,10" BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="1" Cursor="Hand" MouseDown="OnLicenseDotNetClicked">
                            <StackPanel>
                                <TextBlock Text=".NET Runtime &amp; WPF Framework" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13"/>
                                <TextBlock Text="MIT License • github.com/dotnet ↗" Foreground="#38BDF8" FontSize="11" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- Bottom Action Bar with Close Button -->
        <Grid Grid.Row="1" Margin="0,14,0,0">
            <TextBlock Text="RUHI Browser • Version 1.0.0 (Official Release)" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center"/>
            <Button Content="Close" HorizontalAlignment="Right" Width="100" Height="34"
                    Background="#2563EB" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="13"
                    BorderThickness="0" Cursor="Hand" Click="OnCloseClicked">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="8"/>
                    </Style>
                </Button.Resources>
            </Button>
        </Grid>
    </Grid>
</Window>
