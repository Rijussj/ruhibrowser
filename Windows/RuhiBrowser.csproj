<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net6.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Assets\app_icon.ico</ApplicationIcon>
    <AssemblyName>RuhiBrowser</AssemblyName>
    <Title>RUHI Browser</Title>
    <Product>RUHI Browser</Product>
    <Company>RUHI Application</Company>
    <Authors>Saikh Sufian</Authors>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Copyright>© 2026 RUHI Application. All rights reserved.</Copyright>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\app_icon.ico" />
    <Resource Include="Assets\app_icon.png" />
    <Resource Include="Assets\wallpaper1.jpg" />
    <Resource Include="Assets\wallpaper2.jpg" />
    <Resource Include="Assets\wallpaper3.jpg" />
  </ItemGroup>

  <ItemGroup>
    <None Update="store\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
