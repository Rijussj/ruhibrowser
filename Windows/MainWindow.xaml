<Window x:Class="RuhiBrowser.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RUHI Browser"
        Height="800" Width="1200"
        MinHeight="500" MinWidth="750"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Background="#181818"
        Foreground="#F8FAFC"
        FontFamily="Segoe UI"
        KeyDown="OnWindowKeyDown"
        Loaded="OnWindowLoaded"
        Icon="/Assets/app_icon.ico"
        AllowDrop="True"
        PreviewDragOver="OnWindowDragOver"
        Drop="OnWindowDrop">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="38"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="1"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Dynamic Menu Resources -->
        <SolidColorBrush x:Key="MenuBgBrush" Color="#242424"/>
        <SolidColorBrush x:Key="MenuBorderBrush" Color="#3C4043"/>
        <SolidColorBrush x:Key="MenuTextBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="MenuHoverBrush" Color="#383838"/>
        <SolidColorBrush x:Key="MenuSepBrush" Color="#383838"/>

        <!-- Modern Chrome-Style ContextMenu Style (No Aero white line / no icon gutter) -->
        <Style x:Key="ModernContextMenu" TargetType="ContextMenu">
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Background" Value="{DynamicResource MenuBgBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource MenuTextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource MenuBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="HasDropShadow" Value="True"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="4,4"
                                SnapsToDevicePixels="True">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                                <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                            </ScrollViewer>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernMenuItem" TargetType="MenuItem">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Foreground" Value="{DynamicResource MenuTextBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Grid>
                            <Border x:Name="ItemBorder"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="5"
                                    Margin="2,1"
                                    Padding="{TemplateBinding Padding}"
                                    SnapsToDevicePixels="True">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter ContentSource="Header"
                                                      RecognizesAccessKey="True"
                                                      VerticalAlignment="Center"/>
                                    <TextBlock x:Name="SubMenuArrow"
                                               Grid.Column="1"
                                               Text="›"
                                               FontSize="14"
                                               FontWeight="Bold"
                                               Margin="12,0,0,0"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource MenuTextBrush}"
                                               Visibility="Collapsed"/>
                                </Grid>
                            </Border>
                            <Popup x:Name="SubMenuPopup"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                   Placement="Right"
                                   PopupAnimation="Fade">
                                <Border Background="{DynamicResource MenuBgBrush}"
                                        BorderBrush="{DynamicResource MenuBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="4,4"
                                        SnapsToDevicePixels="True">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="HasItems" Value="True">
                                <Setter TargetName="SubMenuArrow" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource MenuHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Separator">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Margin" Value="6,4"/>
            <Setter Property="Background" Value="{DynamicResource MenuSepBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Background="{TemplateBinding Background}" Height="1" SnapsToDevicePixels="True"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NavBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#383838"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#475569"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernNewsPillBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="#141E33"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="BorderBrush" Value="#25354F"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="16,7"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="18"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="#3B82F6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernRefreshBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="#1E3A8A"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#3B82F6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="18"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#2563EB"/>
                                <Setter Property="BorderBrush" Value="#60A5FA"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#1D4ED8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WindowCloseBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="42"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#DC2626"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ShortcutTileStyle" TargetType="Border">
            <Setter Property="Background" Value="#383838"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="8,10"/>
            <Setter Property="Margin" Value="6"/>
            <Setter Property="Width" Value="112"/>
            <Setter Property="Height" Value="88"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- 0: Tab Strip -->
            <RowDefinition Height="38"/>
            <!-- 1: Navigation Toolbar -->
            <RowDefinition Height="48"/>
            <!-- 2: Loading Indicator -->
            <RowDefinition Height="2"/>
            <!-- 3: Main Content Area -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Row 0: Chrome / Edge Style Tab Strip -->
        <Border x:Name="BorderTabStrip" Grid.Row="0" Background="#1F1F1F" BorderBrush="#383838" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Tab Headers and '+' Button directly after tabs on the left -->
                <ScrollViewer x:Name="TabScrollViewer" Grid.Column="0" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                               HorizontalAlignment="Left" WindowChrome.IsHitTestVisibleInChrome="True"
                               PreviewMouseWheel="OnTabScrollViewerPreviewMouseWheel">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                        <StackPanel x:Name="SpTabs" Orientation="Horizontal" VerticalAlignment="Bottom"/>
                        <!-- New Tab '+' Button right after the tabs -->
                        <Button x:Name="BtnNewTab" Content="+" Style="{StaticResource NavBtnStyle}" Width="28" Height="28"
                                Margin="4,0,8,2" FontSize="16" FontWeight="Bold" ToolTip="New tab (Ctrl+T)"
                                Click="OnNewTabClicked" WindowChrome.IsHitTestVisibleInChrome="True" VerticalAlignment="Center"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- Window Control Buttons (_, 🗖, ✕) at top right -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" HorizontalAlignment="Right"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button x:Name="BtnWindowMinimize" Content="—" Style="{StaticResource NavBtnStyle}" Width="40" Height="34" FontSize="11"
                            ToolTip="Minimize" Click="OnMinimizeClicked" WindowChrome.IsHitTestVisibleInChrome="True"/>
                    <Button x:Name="BtnWindowMaximize" Content="🗖" Style="{StaticResource NavBtnStyle}" Width="40" Height="34" FontSize="11"
                            ToolTip="Maximize / Restore" Click="OnMaximizeClicked" WindowChrome.IsHitTestVisibleInChrome="True"/>
                    <Button x:Name="BtnWindowClose" Content="✕" Style="{StaticResource WindowCloseBtnStyle}" Width="42" Height="34" FontSize="11"
                            ToolTip="Close" Click="OnCloseClicked" WindowChrome.IsHitTestVisibleInChrome="True"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Row 1: Navigation Toolbar -->
        <Border x:Name="BorderNavToolbar" Grid.Row="1" Background="#28292C" BorderBrush="#383838" BorderThickness="0,0,0,1" Padding="8,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left Nav: Back, Forward, Reload, Home -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnBack" Content="←" Style="{StaticResource NavBtnStyle}" ToolTip="Back (Alt+Left)" Click="OnBackClicked"/>
                    <Button x:Name="BtnForward" Content="→" Style="{StaticResource NavBtnStyle}" ToolTip="Forward (Alt+Right)" Click="OnForwardClicked"/>
                    <Button x:Name="BtnReload" Content="↻" Style="{StaticResource NavBtnStyle}" ToolTip="Reload (Ctrl+R / F5)" Click="OnReloadClicked"/>
                    <Button x:Name="BtnHome" Content="⌂" Style="{StaticResource NavBtnStyle}" FontSize="18" ToolTip="Home" Click="OnHomeClicked"/>
                </StackPanel>

                <!-- Center: Address Bar (Omnibox) -->
                <Border x:Name="BorderOmnibox" Grid.Column="1" Background="#202124" CornerRadius="20" BorderBrush="#3C4043" BorderThickness="1"
                        Margin="8,2" Padding="12,0" VerticalAlignment="Center" Height="36">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Lock Indicator -->
                        <TextBlock x:Name="TbSecurityIcon" Grid.Column="0" Text="🔒" FontSize="12" VerticalAlignment="Center"
                                   Margin="0,0,8,0" Foreground="#22C55E"/>

                        <!-- URL / Search TextBox -->
                        <TextBox x:Name="TbUrl" Grid.Column="1" Background="Transparent" Foreground="#F8FAFC"
                                 BorderThickness="0" FontSize="13" VerticalAlignment="Center"
                                 KeyDown="OnUrlKeyDown" GotFocus="OnUrlGotFocus" LostFocus="OnUrlLostFocus"
                                 TextChanged="OnUrlTextChanged"
                                 PreviewMouseLeftButtonDown="OnUrlPreviewMouseLeftButtonDown"
                                 MouseDoubleClick="OnUrlMouseDoubleClick"
                                 AllowDrop="True" PreviewDragOver="OnUrlPreviewDragOver" Drop="OnUrlDrop"/>

                        <!-- Shield Counter Badge -->
                        <Button x:Name="BtnShield" Grid.Column="2" Style="{StaticResource NavBtnStyle}"
                                Width="Auto" Padding="5,1" Margin="2,0" ToolTip="RUHI Privacy &amp; Ad Shield"
                                Click="OnShieldClicked" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="🛡️" FontSize="11" Margin="0,0,3,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TbShieldCount" Text="0" FontSize="10.5" FontWeight="Bold" Foreground="#38BDF8" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Zoom Reset Badge -->
                        <Button x:Name="BtnZoom" Grid.Column="3" Content="100%" Style="{StaticResource NavBtnStyle}"
                                Width="Auto" Padding="6,2" FontSize="11" Margin="2,0"
                                ToolTip="Zoom level (Click to reset to 100%)"
                                Click="OnResetZoomClicked" Visibility="Collapsed"/>

                        <!-- Star Bookmark Button -->
                        <Button x:Name="BtnBookmark" Grid.Column="4" Content="☆" Style="{StaticResource NavBtnStyle}"
                                Width="28" Height="28" FontSize="15" Margin="4,0,0,0" ToolTip="Bookmark this tab" Click="OnBookmarkClicked"/>
                    </Grid>
                </Border>

                <!-- Privacy Shield Details Popup -->
                <Popup x:Name="PopupShield" PlacementTarget="{Binding ElementName=BtnShield}"
                       Placement="Bottom" StaysOpen="False" AllowsTransparency="True" HorizontalOffset="-140" VerticalOffset="8">
                    <Border Background="#1E293B" CornerRadius="12" BorderBrush="#334155" BorderThickness="1"
                            Padding="16" Width="280">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.4" Color="Black"/>
                        </Border.Effect>
                        <StackPanel>
                            <!-- Header: Icon & Domain -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Background="#0F172A" CornerRadius="8" Width="36" Height="36" Margin="0,0,10,0">
                                    <TextBlock Text="🛡️" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="TbShieldSiteDomain" Text="example.com" FontSize="13" FontWeight="Bold" Foreground="#F8FAFC" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock x:Name="TbShieldStatusText" Text="Protection is Active" FontSize="11" Foreground="#10B981" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Grid>

                            <!-- Stat Card -->
                            <Border Background="#0F172A" CornerRadius="8" Padding="12,10" Margin="0,0,0,12" BorderBrush="#25354F" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Blocked on this page" FontSize="11" Foreground="#94A3B8"/>
                                        <TextBlock x:Name="TbShieldPageBlocked" Text="0 ads &amp; trackers" FontSize="14" FontWeight="Bold" Foreground="#38BDF8"/>
                                    </StackPanel>
                                    <TextBlock x:Name="TbShieldTotalSession" Grid.Column="1" Text="Total: 0" FontSize="10.5" Foreground="#64748B" VerticalAlignment="Bottom"/>
                                </Grid>
                            </Border>

                            <!-- Toggle Protection for this site -->
                            <Border Background="#141E33" CornerRadius="8" Padding="10,8" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Shield for this site" FontSize="12" Foreground="#E2E8F0" VerticalAlignment="Center"/>
                                    <CheckBox x:Name="CbShieldSiteToggle" Grid.Column="1" IsChecked="True" VerticalAlignment="Center" Click="OnShieldSiteToggleClicked"/>
                                </Grid>
                            </Border>

                            <!-- Footer info -->
                            <TextBlock Text="Blocking ads, trackers &amp; malicious scripts" FontSize="10" Foreground="#64748B" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Popup>

                <!-- Right Nav: Tools & Menu -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnPdfEdit" Content="✏️ PDF Edit" Style="{StaticResource NavBtnStyle}"
                            Width="84" FontSize="11" FontWeight="SemiBold" ToolTip="PDF Editing Tools (Draw, Text, Annotate, Rotate)"
                            Margin="0,0,4,0" Click="OnPdfEditClicked" Visibility="Collapsed"/>
                    <Button x:Name="BtnAi" Content="✨" Style="{StaticResource NavBtnStyle}" ToolTip="RUHI AI Assistant" Click="OnAiClicked"/>
                    <Button x:Name="BtnTranslate" Content="🌐" Style="{StaticResource NavBtnStyle}" ToolTip="Translate Page" Click="OnTranslateClicked"/>
                    <Button x:Name="BtnReader" Content="📖" Style="{StaticResource NavBtnStyle}" ToolTip="Reader Mode" Click="OnReaderModeClicked"/>
                    <Button x:Name="BtnSplitScreen" Content="🪟" Style="{StaticResource NavBtnStyle}" ToolTip="Split Screen (Side-by-Side Dual Tabs)" Click="OnSplitScreenClicked"/>
                    <!-- Downloads Button with Chrome-style Circular Progress Ring -->
                    <Grid x:Name="DownloadsBtnGrid" VerticalAlignment="Center" Margin="0,0,2,0">
                        <Button x:Name="BtnDownloads" Style="{StaticResource NavBtnStyle}" Width="36" Height="36"
                                ToolTip="Downloads" Click="OnDownloadsClicked">
                            <Grid Width="28" Height="28">
                                <!-- Download Arrow / Status Icon -->
                                <TextBlock x:Name="TbDownloadIcon" Text="⬇" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="#94A3B8"/>
                                <!-- Circular Progress Ring Arc -->
                                <Path x:Name="PathDownloadRing" Stroke="#3B82F6" StrokeThickness="2.5"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Width="28" Height="28" HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Visibility="Collapsed"/>
                                <!-- Active count badge -->
                                <Border x:Name="BadgeActiveDownloads" Background="#2563EB" CornerRadius="6" MinWidth="13" Height="13"
                                        Padding="3,0" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-2,-3,0"
                                        Visibility="Collapsed">
                                    <TextBlock x:Name="TbActiveDownloadCount" Text="1" FontSize="9" FontWeight="Bold" Foreground="#FFFFFF"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </Button>
                    </Grid>
                    <Grid VerticalAlignment="Center" Margin="0,0,2,0">
                        <Button x:Name="BtnSendToPhone" Style="{StaticResource NavBtnStyle}" ToolTip="Send Tab to Phone (📱)" Click="OnSendToPhoneClicked">
                            <Grid>
                                <TextBlock Text="📱" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Ellipse x:Name="DotSyncActive" Width="7" Height="7" Fill="#22C55E" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-2,-2" Visibility="Collapsed"/>
                            </Grid>
                        </Button>
                    </Grid>
                    <Button x:Name="BtnExtensions" Content="🧩" Style="{StaticResource NavBtnStyle}" ToolTip="Extensions Manager" Click="OnExtensionsClicked"/>
                    <Button x:Name="BtnMenu" Content="⋮" Style="{StaticResource NavBtnStyle}" FontSize="18" ToolTip="Menu" Click="OnMenuClicked"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- URL Omnibox Suggestions Dropdown Popup -->
        <Popup x:Name="PopupUrlSuggestions" PlacementTarget="{Binding ElementName=BorderOmnibox}" Placement="Bottom"
               AllowsTransparency="True" StaysOpen="False" PopupAnimation="Fade" VerticalOffset="4">
            <Border x:Name="BorderUrlSuggestions" Width="{Binding ActualWidth, ElementName=BorderOmnibox}"
                    Background="#242424" BorderBrush="#3C4043" BorderThickness="1"
                    CornerRadius="12" Padding="6" MaxHeight="340" SnapsToDevicePixels="True">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="20" ShadowDepth="4" Opacity="0.5"/>
                </Border.Effect>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="PanelUrlSuggestions"/>
                </ScrollViewer>
            </Border>
        </Popup>

        <!-- Chrome-Style Download Manager Hub Popup -->
        <Popup x:Name="PopupDownloads" PlacementTarget="{Binding ElementName=BtnDownloads}" Placement="Bottom"
               AllowsTransparency="True" StaysOpen="False" PopupAnimation="Fade" VerticalOffset="6" HorizontalOffset="-320">
            <Border x:Name="BorderDownloadsPopup" Background="#242424" BorderBrush="#383838" BorderThickness="1"
                    CornerRadius="10" Width="380" MaxHeight="480" SnapsToDevicePixels="True">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="20" ShadowDepth="4" Opacity="0.45"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Header -->
                        <RowDefinition Height="*"/>    <!-- Downloads List ScrollViewer -->
                        <RowDefinition Height="Auto"/> <!-- Footer / Summary -->
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Border Grid.Row="0" BorderBrush="#383838" BorderThickness="0,0,0,1" Padding="14,10" x:Name="BorderDownloadsHeader">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Downloads" FontSize="14" FontWeight="Bold" Foreground="#FFFFFF" x:Name="TbDownloadsHeaderTitle"/>
                                <TextBlock x:Name="TbDownloadsHeaderCount" Text="" FontSize="11" Foreground="#94A3B8" Margin="8,2,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="📁 Open Folder" Background="Transparent" Foreground="#38BDF8"
                                    BorderThickness="0" FontSize="11.5" FontWeight="SemiBold" Padding="6,4" Cursor="Hand"
                                    Margin="0,0,4,0" ToolTip="Open default downloads folder in File Explorer"
                                    Click="OnOpenDownloadsFolderClicked"/>
                            <Button Grid.Column="2" Content="🧹 Clear" Background="Transparent" Foreground="#94A3B8"
                                    BorderThickness="0" FontSize="11.5" Padding="6,4" Cursor="Hand"
                                    ToolTip="Clear finished downloads list"
                                    Click="OnClearDownloadsListClicked"/>
                        </Grid>
                    </Border>

                    <!-- Content: List of Downloads or Empty State -->
                    <Grid Grid.Row="1" MinHeight="100">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="360" Padding="0,4">
                            <StackPanel x:Name="PanelDownloadsList">
                                <!-- Populated dynamically via RenderDownloadsHub() -->
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Empty State -->
                        <StackPanel x:Name="PanelDownloadsEmpty" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20,30" Visibility="Collapsed">
                            <TextBlock Text="📥" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,8" Opacity="0.7"/>
                            <TextBlock Text="No downloads yet" FontSize="13" FontWeight="SemiBold" Foreground="#94A3B8" HorizontalAlignment="Center" x:Name="TbDownloadsEmptyTitle"/>
                            <TextBlock Text="Files you download will appear here" FontSize="11" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>

                    <!-- Footer: Status Summary -->
                    <Border Grid.Row="2" BorderBrush="#383838" BorderThickness="0,1,0,0" Padding="12,8" Background="#181818" x:Name="BorderDownloadsFooter">
                        <Grid>
                            <TextBlock x:Name="TbDownloadsFooterStatus" Text="Ready" FontSize="11" Foreground="#64748B" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TbDownloadsSpeedBadge" Text="" FontSize="11" FontWeight="SemiBold" Foreground="#3B82F6" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Popup>

        <!-- Row 2: Thin Loading Indicator -->
        <ProgressBar x:Name="PbLoading" Grid.Row="2" Height="2" Background="Transparent" Foreground="#3B82F6"
                     BorderThickness="0" IsIndeterminate="True" Visibility="Collapsed"/>

        <!-- Row 3: Main Viewport (Home Screen or WebViews) -->
        <Grid Grid.Row="3">
            <!-- Home Screen (New Tab View) -->
            <ScrollViewer x:Name="HomeScreen" VerticalScrollBarVisibility="Auto" Background="#181818">
                <Grid>
                    <!-- Scenic Wallpaper Background (used in Wallpaper mode) -->
                    <Grid x:Name="BorderWallpaperBackdrop" Visibility="Collapsed" IsHitTestVisible="False">
                        <!-- Fallback Scenic Gradient -->
                        <Border>
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#0B132B" Offset="0.0"/>
                                    <GradientStop Color="#1C2541" Offset="0.35"/>
                                    <GradientStop Color="#2D1152" Offset="0.7"/>
                                    <GradientStop Color="#0369A1" Offset="1.0"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <!-- High Definition Wallpaper Image -->
                        <Image x:Name="ImgWallpaperBackdrop" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <!-- Dark tint overlay for Wallpaper mode readability -->
                        <Border x:Name="BorderWallpaperOverlay" Background="#77050814"/>
                    </Grid>

                    <StackPanel x:Name="SpHomeMainContainer" HorizontalAlignment="Stretch" VerticalAlignment="Top" Margin="24,24,24,60" MaxWidth="1080">


                        <!-- Productive Mode Header: Big Digital Clock, Live Seconds, Greeting & Motivational Quote -->
                        <StackPanel x:Name="SpHomeProductiveHeader" Visibility="Collapsed" HorizontalAlignment="Center" Margin="0,0,0,20">
                            <!-- Clock & Seconds row -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock x:Name="TbHomeClock" Text="12:00" FontSize="60" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,8,0"/>
                                <StackPanel VerticalAlignment="Bottom" Margin="0,0,0,10">
                                    <Border Background="#383838" CornerRadius="6" Padding="6,2" Margin="0,0,0,3">
                                        <TextBlock x:Name="TbHomeClockSeconds" Text=":00" FontSize="13" FontWeight="Bold" Foreground="#38BDF8"/>
                                    </Border>
                                    <TextBlock x:Name="TbHomeClockAmPm" Text="PM" FontSize="12.5" FontWeight="Bold" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>
                            <!-- Greeting & Date pill -->
                            <Border x:Name="BorderHomeGreeting" Background="#141E33" CornerRadius="16" BorderBrush="#25354F" BorderThickness="1" Padding="14,6" Margin="0,4,0,8" HorizontalAlignment="Center">
                                <TextBlock x:Name="TbHomeGreeting" Text="Good afternoon, Welcome to RUHI  •  📅 Thursday, 22 Oct" FontSize="12.5" FontWeight="SemiBold" Foreground="#E2E8F0" HorizontalAlignment="Center"/>
                            </Border>
                            <!-- Motivational Focus Quote -->
                            <TextBlock x:Name="TbHomeQuote" Text="“Focus on being productive instead of busy.”" FontSize="12" FontStyle="Italic" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                        </StackPanel>

                        <!-- Brand Header -->
                        <StackPanel x:Name="SpHomeBrandHeader">
                            <Image Source="/Assets/app_icon.png" Width="72" Height="72" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                            <TextBlock x:Name="TbHomeTitle" Text="RUHI Browser" FontSize="30" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="TbHomeSubtitle" Text="Fast, Secure &amp; Private Browsing" FontSize="13" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,3,0,22"/>
                        </StackPanel>

                        <!-- Big Central Search Bar -->
                        <Border x:Name="BorderHomeSearch" Background="#202124" CornerRadius="24" BorderBrush="#3C4043" BorderThickness="1"
                                Padding="16,4" Height="48" Margin="0,0,0,26" Width="680" MaxWidth="720">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="🔍" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="#64748B"/>
                                <TextBox x:Name="TbHomeSearch" Grid.Column="1" Background="Transparent" Foreground="#FFFFFF"
                                         BorderThickness="0" FontSize="14" VerticalAlignment="Center"
                                         KeyDown="OnHomeSearchKeyDown"/>
                                <Button Grid.Column="2" Content="Search" Background="#2563EB" Foreground="#FFFFFF"
                                         FontWeight="SemiBold" BorderThickness="0" Padding="14,6" VerticalAlignment="Center"
                                         Cursor="Hand" Click="OnHomeSearchClicked">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="16"/>
                                        </Style>
                                    </Button.Resources>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- Shortcuts Section -->
                        <Grid Margin="6,0,6,10" Width="680" MaxWidth="720">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="TbShortcutsTitle" Text="Quick Shortcuts" FontSize="13" FontWeight="SemiBold" Foreground="#94A3B8" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="(Right-click shortcut to edit/delete)" FontSize="11" Foreground="#64748B" VerticalAlignment="Center"/>
                        </Grid>
                        <WrapPanel x:Name="WpShortcuts" Margin="0,0,0,20" HorizontalAlignment="Center"/>

                        <!-- Productive Mode: Today's Main Focus Goal Card -->
                        <Border x:Name="BorderHomeDailyGoal" Visibility="Collapsed" Background="#242424" CornerRadius="14" BorderBrush="#383838" BorderThickness="1" Padding="14,10" Margin="0,0,0,16" Width="680" MaxWidth="720">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox x:Name="CbDailyGoalCheck" VerticalAlignment="Center" Margin="4,0,10,0" Checked="OnDailyGoalCheckChanged" Unchecked="OnDailyGoalCheckChanged" ToolTip="Mark goal as completed"/>
                                <Grid Grid.Column="1" VerticalAlignment="Center">
                                    <TextBox x:Name="TbDailyFocusGoal" Background="Transparent" Foreground="#F8FAFC" BorderThickness="0" FontSize="13.5" FontWeight="Medium" VerticalAlignment="Center" TextChanged="OnDailyFocusGoalChanged" GotFocus="OnDailyGoalGotFocus" LostFocus="OnDailyGoalLostFocus"/>
                                    <TextBlock x:Name="TbDailyGoalPlaceholder" Text="🎯 Today's Main Focus Goal (Click to type your goal)..." FontSize="13.5" Foreground="#64748B" VerticalAlignment="Center" IsHitTestVisible="False" Margin="2,0,0,0"/>
                                </Grid>
                                <TextBlock x:Name="TbDailyGoalBadge" Grid.Column="2" Text="Done! 🎉" FontSize="12" FontWeight="Bold" Foreground="#10B981" VerticalAlignment="Center" Visibility="Collapsed" Margin="8,0,4,0"/>
                            </Grid>
                        </Border>

                        <!-- Productive Mode: Pomodoro Focus Timer Card -->
                        <Border x:Name="BorderHomePomodoro" Visibility="Collapsed" Background="#242424" CornerRadius="14" BorderBrush="#383838" BorderThickness="1" Padding="16,12" Margin="0,0,0,16" Width="680" MaxWidth="720">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Left: Timer Modes & Big Time -->
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock x:Name="TbPomodoroTime" Text="25:00" FontSize="26" FontWeight="Bold" Foreground="#38BDF8" VerticalAlignment="Center" Margin="0,0,16,0" FontFamily="Consolas, Segoe UI"/>
                                    <StackPanel VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <Button x:Name="BtnPomoFocus" Content="🎯 Focus 25m" Tag="25" Style="{StaticResource NavBtnStyle}" Width="Auto" Padding="8,3" FontSize="11" Margin="0,0,4,0" Click="OnPomodoroModeClicked"/>
                                            <Button x:Name="BtnPomoShort" Content="☕ Short Break 5m" Tag="5" Style="{StaticResource NavBtnStyle}" Width="Auto" Padding="8,3" FontSize="11" Margin="0,0,4,0" Click="OnPomodoroModeClicked"/>
                                            <Button x:Name="BtnPomoLong" Content="🌴 Long Break 15m" Tag="15" Style="{StaticResource NavBtnStyle}" Width="Auto" Padding="8,3" FontSize="11" Click="OnPomodoroModeClicked"/>
                                        </StackPanel>
                                        <TextBlock x:Name="TbPomodoroStatus" Text="Ready to focus • 25 min session" FontSize="11" Foreground="#94A3B8"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Right: Action Buttons -->
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button x:Name="BtnPomodoroToggle" Content="▶ Start" Background="#2563EB" Foreground="#FFFFFF" FontWeight="SemiBold" BorderThickness="0" Padding="14,6" Margin="0,0,6,0" Cursor="Hand" Click="OnPomodoroToggleClicked">
                                        <Button.Resources>
                                            <Style TargetType="Border"><Setter Property="CornerRadius" Value="14"/></Style>
                                        </Button.Resources>
                                    </Button>
                                    <Button Content="+5m" Style="{StaticResource NavBtnStyle}" Width="Auto" Padding="8,4" FontSize="11" Margin="0,0,4,0" Click="OnPomodoroAdd5MinClicked" ToolTip="Add 5 minutes"/>
                                    <Button Content="🔄" Style="{StaticResource NavBtnStyle}" Width="32" Height="30" Padding="0" FontSize="12" Click="OnPomodoroResetClicked" ToolTip="Reset timer"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Productive Mode: Quick Scratchpad / Action Notes Section -->
                        <Border x:Name="BorderHomeNotes" Visibility="Collapsed" Background="#242424" CornerRadius="14" BorderBrush="#383838" BorderThickness="1" Padding="16,14" Margin="0,0,0,16" Width="680" MaxWidth="720">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="📝 Quick Scratchpad &amp; Notes" FontSize="13" FontWeight="SemiBold" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <TextBlock x:Name="TbNotesWordCount" Text="0 words • 0 chars" FontSize="11" Foreground="#64748B" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button Content="• Bullet" Style="{StaticResource NavBtnStyle}" Width="Auto" Padding="8,2" FontSize="11" Margin="0,0,4,0" Click="OnNotesAddBulletClicked" ToolTip="Insert bullet point"/>
                                        <Button Content="🕒 Time" Style="{StaticResource NavBtnStyle}" Width="Auto" Padding="8,2" FontSize="11" Margin="0,0,4,0" Click="OnNotesAddTimeClicked" ToolTip="Insert current timestamp"/>
                                        <Button Content="📋 Copy" Style="{StaticResource NavBtnStyle}" Width="Auto" Padding="8,2" FontSize="11" Margin="0,0,4,0" Click="OnCopyNotesClicked" ToolTip="Copy notes to clipboard"/>
                                        <Button Content="✕ Clear" Style="{StaticResource NavBtnStyle}" Width="Auto" Padding="8,2" Margin="0" FontSize="11" Click="OnClearNotesClicked" ToolTip="Clear scratchpad"/>
                                    </StackPanel>
                                </Grid>
                                <TextBox x:Name="TbQuickNote" Background="#181818" Foreground="#F8FAFC" BorderBrush="#383838" BorderThickness="1"
                                         Padding="12,10" FontSize="13.5" Height="130" TextWrapping="Wrap" AcceptsReturn="True"
                                         VerticalScrollBarVisibility="Auto" TextChanged="OnQuickNoteChanged"/>
                            </StackPanel>
                        </Border>

                        <!-- Productive Mode: Quick Launch Workspace -->
                        <Border x:Name="BorderHomeProductiveTools" Visibility="Collapsed" Background="#242424" CornerRadius="14" BorderBrush="#383838" BorderThickness="1" Padding="14,10" Margin="0,0,0,20" Width="680" MaxWidth="720">
                            <StackPanel>
                                <TextBlock Text="⚡ Quick Launch Workspace" FontSize="12" FontWeight="SemiBold" Foreground="#94A3B8" Margin="2,0,0,8"/>
                                <WrapPanel HorizontalAlignment="Center">
                                    <Button Content="📄 Google Docs" Tag="https://docs.new" Style="{StaticResource NavBtnStyle}" Width="Auto" Padding="10,4" Margin="3" FontSize="11.5" Click="OnProductiveQuickToolClicked"/>
                                    <Button Content="📊 Sheets" Tag="https://sheets.new" Style="{StaticResource NavBtnStyle}" Width="Auto" Padding="10,4" Margin="3" FontSize="11.5" Click="OnProductiveQuickToolClicked"/>
                                    <Button Content="📅 Calendar" Tag="https://calendar.google.com" Style="{StaticResource NavBtnStyle}" Width="Auto" Padding="10,4" Margin="3" FontSize="11.5" Click="OnProductiveQuickToolClicked"/>
                                    <Button Content="✉️ Gmail" Tag="https://mail.google.com" Style="{StaticResource NavBtnStyle}" Width="Auto" Padding="10,4" Margin="3" FontSize="11.5" Click="OnProductiveQuickToolClicked"/>
                                    <Button Content="🐙 GitHub" Tag="https://github.com" Style="{StaticResource NavBtnStyle}" Width="Auto" Padding="10,4" Margin="3" FontSize="11.5" Click="OnProductiveQuickToolClicked"/>
                                    <Button Content="📝 Notion" Tag="https://notion.so" Style="{StaticResource NavBtnStyle}" Width="Auto" Padding="10,4" Margin="3" FontSize="11.5" Click="OnProductiveQuickToolClicked"/>
                                    <Button Content="🤖 AI Assistant" Tag="ai_assistant" Style="{StaticResource NavBtnStyle}" Width="Auto" Padding="10,4" Margin="3" FontSize="11.5" Click="OnProductiveQuickToolClicked"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <!-- Recent Visits Section (Visible in Standard mode) -->
                        <Border x:Name="BorderRecentVisits" Background="#242424" CornerRadius="12" BorderBrush="#383838" BorderThickness="1" Padding="16" Width="680" MaxWidth="720">
                            <StackPanel>
                                <TextBlock x:Name="TbRecentVisitsTitle" Text="Recent Visits" FontSize="14" FontWeight="SemiBold" Foreground="#94A3B8" Margin="0,0,0,10"/>
                                <StackPanel x:Name="SpRecentVisits"/>
                            </StackPanel>
                        </Border>

                        <!-- News Section (Open Edge-Style MSN Feed, Visible in With News mode) -->
                        <Border x:Name="BorderHomeNews" Visibility="Collapsed" Background="Transparent" BorderThickness="0" Padding="0" Margin="0,18,0,30" HorizontalAlignment="Stretch">
                            <StackPanel HorizontalAlignment="Stretch">
                                <!-- Edge Feed Header Bar: Left Pill Tabs, Right Date Glance & Refresh -->
                                <Grid Margin="0,0,0,18">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Category Navigation Pills -->
                                    <ScrollViewer Grid.Column="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button x:Name="BtnNewsCatTop" Content="🔥 Top Stories" Tag="top" Style="{StaticResource ModernNewsPillBtnStyle}" Margin="0,0,8,0" Click="OnNewsCategoryClicked"/>
                                            <Button x:Name="BtnNewsCatTech" Content="💻 Tech" Tag="tech" Style="{StaticResource ModernNewsPillBtnStyle}" Margin="0,0,8,0" Click="OnNewsCategoryClicked"/>
                                            <Button x:Name="BtnNewsCatBusiness" Content="💼 Finance" Tag="business" Style="{StaticResource ModernNewsPillBtnStyle}" Margin="0,0,8,0" Click="OnNewsCategoryClicked"/>
                                            <Button x:Name="BtnNewsCatSports" Content="🏏 Sports" Tag="sports" Style="{StaticResource ModernNewsPillBtnStyle}" Margin="0,0,8,0" Click="OnNewsCategoryClicked"/>
                                            <Button x:Name="BtnNewsCatEntertainment" Content="🎬 Entertainment" Tag="entertainment" Style="{StaticResource ModernNewsPillBtnStyle}" Margin="0,0,8,0" Click="OnNewsCategoryClicked"/>
                                            <Button x:Name="BtnNewsCatWorld" Content="⚡ Breaking" Tag="world" Style="{StaticResource ModernNewsPillBtnStyle}" Margin="0,0,8,0" Click="OnNewsCategoryClicked"/>
                                        </StackPanel>
                                    </ScrollViewer>

                                    <!-- Right Glance: Date Briefing & Refresh -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                                        <Border Background="#141E33" CornerRadius="18" BorderBrush="#25354F" BorderThickness="1" Padding="14,7" Margin="0,0,10,0">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Ellipse Width="8" Height="8" Fill="#10B981" Margin="0,0,6,0"/>
                                                <TextBlock Text="LIVE" FontSize="10" FontWeight="Bold" Foreground="#10B981" Margin="0,0,8,0"/>
                                                <TextBlock x:Name="TbNewsDateGlance" Text="🕒 2:15 PM  •  📅 Thursday, 22 Oct" FontSize="11.5" FontWeight="SemiBold" Foreground="#E2E8F0"/>
                                            </StackPanel>
                                        </Border>
                                        <Button Content="🔄 Refresh" Style="{StaticResource ModernRefreshBtnStyle}" Click="OnRefreshNewsClicked" ToolTip="Refresh latest news headlines"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Loading / Status indicator -->
                                <TextBlock x:Name="TbNewsLoadingStatus" Text="" FontSize="12.5" Foreground="#94A3B8" Visibility="Collapsed" Margin="0,0,0,12" HorizontalAlignment="Center"/>

                                <!-- Lead / Hero Featured Story Card Container -->
                                <Border x:Name="BorderHeroArticle" Visibility="Collapsed" Margin="0,0,0,16" HorizontalAlignment="Stretch"/>

                                <!-- 3-Column Edge Stories Grid -->
                                <UniformGrid x:Name="UgNewsArticles" Columns="3" HorizontalAlignment="Stretch"/>

                                <!-- Load More Headlines Button -->
                                <Button x:Name="BtnNewsLoadMore" Content="⬇ Load More Headlines" Style="{StaticResource ModernNewsPillBtnStyle}" HorizontalAlignment="Center" Margin="0,18,0,10" Padding="24,8" Visibility="Collapsed" Click="OnNewsLoadMoreClicked"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </ScrollViewer>

            <!-- Active WebView2 Host Container (Supports Single & Split View) -->
            <Grid x:Name="WebContainer" Visibility="Collapsed" Margin="4,0,4,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="ColWebLeft" Width="*"/>
                    <ColumnDefinition x:Name="ColWebSplitter" Width="Auto"/>
                    <ColumnDefinition x:Name="ColWebRight" Width="0"/>
                </Grid.ColumnDefinitions>

                <!-- Left Host (Main / Active Tab) -->
                <Grid x:Name="GridWebLeft" Grid.Column="0"/>

                <!-- GridSplitter (Draggable) -->
                <GridSplitter x:Name="SplitterWeb" Grid.Column="1" Width="4" HorizontalAlignment="Center"
                              VerticalAlignment="Stretch" Background="#334155" ShowsPreview="False" Visibility="Collapsed"/>

                <!-- Right Host (Split View Secondary Tab) -->
                <Grid x:Name="GridWebRight" Grid.Column="2" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Right Panel Header (Edge style) -->
                    <Border Grid.Row="0" Background="#1E293B" BorderBrush="#334155" BorderThickness="0,0,0,1" Padding="8,4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="🪟" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TbSplitRightTitle" Text="Right Tab" FontSize="11.5" FontWeight="SemiBold"
                                           Foreground="#E2E8F0" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="✕" Style="{StaticResource NavBtnStyle}" Width="20" Height="20"
                                    FontSize="10" ToolTip="Close Split Screen" Click="OnCloseSplitScreenClicked"/>
                        </Grid>
                    </Border>

                    <!-- Right WebView Host -->
                    <Grid x:Name="GridWebRightContent" Grid.Row="1"/>
                </Grid>
            </Grid>

            <!-- Floating Find in Page Bar (Ctrl+F) -->
            <Border x:Name="FindInPageBar" Visibility="Collapsed" VerticalAlignment="Top" HorizontalAlignment="Right"
                    Margin="0,12,20,0" Background="#202124" CornerRadius="8" BorderBrush="#3C4043" BorderThickness="1"
                    Padding="10,6" Panel.ZIndex="100">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🔍" FontSize="13" Foreground="#94A3B8" VerticalAlignment="Center" Margin="2,0,8,0"/>
                    <TextBox x:Name="TbFindQuery" Width="190" Background="#383838" Foreground="#FFFFFF" BorderBrush="#3C4043"
                             Padding="6,4" FontSize="12" VerticalAlignment="Center" KeyDown="OnFindQueryKeyDown" TextChanged="OnFindQueryChanged"/>
                    <TextBlock x:Name="TbFindCount" Text="0/0" Foreground="#94A3B8" FontSize="11" Margin="10,0" VerticalAlignment="Center"/>
                    <Button Content="▲" Style="{StaticResource NavBtnStyle}" Width="28" Height="28" FontSize="11" ToolTip="Previous Match (Shift+F3)" Click="OnFindPreviousClicked"/>
                    <Button Content="▼" Style="{StaticResource NavBtnStyle}" Width="28" Height="28" FontSize="11" ToolTip="Next Match (F3)" Click="OnFindNextClicked"/>
                    <Button Content="✕" Style="{StaticResource NavBtnStyle}" Width="28" Height="28" FontSize="11" ToolTip="Close (Esc)" Click="OnCloseFindClicked"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
